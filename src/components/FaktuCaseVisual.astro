---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const stages = [
  { number: "01", label: "Contratación y pago" },
  { number: "02", label: "Control de cartera" },
  { number: "03", label: "Gestión automática" },
];
---

<div
  class:list={[
    "relative isolate flex h-full flex-col overflow-hidden bg-[#0b1422] text-white",
    compact ? "min-h-72 p-6 sm:p-8" : "min-h-80 rounded-3xl border border-white/10 p-6 sm:min-h-[430px] sm:p-9",
  ]}
  aria-label="Esquema de las capacidades del sistema de gestión Faktu"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-[#048bd3]" aria-hidden="true"></div>
  <div class="relative flex items-start justify-between gap-4">
    <div class="rounded-xl bg-[#f7f8fa] px-3 py-2">
      <img
        src="/casos/faktu/logo-color.png"
        width="3937"
        height="1116"
        alt="FAKTU.net"
        class="h-7 w-auto sm:h-9"
        loading={compact ? "lazy" : "eager"}
      />
    </div>
    <span class="rounded-full border border-white/15 px-3 py-1.5 font-display text-[9px] font-bold uppercase tracking-[0.15em] text-zinc-300">Chile</span>
  </div>

  <div class="relative my-auto py-8">
    <p class="font-display text-[10px] font-bold uppercase tracking-[0.2em] text-[#59baf0]">Sistema de gestión de cobranza</p>
    <p class:list={["mt-3 max-w-xl font-display font-black leading-tight tracking-tight", compact ? "text-2xl sm:text-4xl" : "text-3xl sm:text-5xl"]}>
      Cada factura bajo control.
    </p>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-zinc-400">Una plataforma para contratar, gestionar y seguir la cobranza.</p>
  </div>

  <div class="relative grid gap-2 border-t border-white/10 pt-4 sm:grid-cols-3">
    {stages.map((stage) => (
      <div class="flex items-center gap-2 rounded-lg border border-white/[0.07] bg-white/[0.03] px-3 py-2">
        <span class="font-display text-[10px] font-bold text-[#59baf0]">{stage.number}</span>
        <span class="font-display text-[10px] font-semibold uppercase tracking-wide text-zinc-200">{stage.label}</span>
      </div>
    ))}
  </div>
</div>
