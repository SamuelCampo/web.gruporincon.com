                    <div class="relative p-1 rounded-full bg-zinc-900 shadow-xl">
                      <div
                        class={`w-20 h-20 sm:w-22 sm:h-22 rounded-full flex items-center justify-center font-display font-black text-2xl sm:text-3xl text-white shadow-inner bg-linear-to-tr ${item.avatarBg} border-2 border-white/80 select-none`}
                      >
                        <span>{item.initial}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Stars Rating -->
                  <div class="testimonial-stars flex justify-center items-center gap-1 mt-2">
                    {
                      [...Array(item.rating || 5)].map(() => (
                        <svg class="w-5 h-5 fill-current star-icon" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))
                    }
                  </div>

                  <!-- Name and Role -->
                  <div class="mt-4">
                    <h3 class="testimonial-name text-lg sm:text-xl font-bold font-display tracking-tight leading-snug">
                      {item.name}
                    </h3>
                    <p class="testimonial-role text-xs sm:text-sm font-medium mt-1">
                      {item.role}
                    </p>
                  </div>

                  <!-- Double Quote Icon -->
                  <div class="testimonial-quote-icon flex justify-center my-4">
                    <svg
                      class="w-8 h-8 fill-current opacity-90 transition-transform duration-300 group-hover:scale-110"
                      viewBox="0 0 24 24"
                    >
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                  </div>

                  <!-- Review Quote Text -->
                  <p class="testimonial-desc text-xs sm:text-sm leading-relaxed line-clamp-4 font-normal">
                    “{item.description}”
                  </p>

                  <!-- Date & Verified indicator -->
                  <div class="mt-4 pt-3 border-t testimonial-border flex items-center justify-between text-[11px] font-medium opacity-80">
                    <span class="testimonial-date">{item.date}</span>
                    <span class="inline-flex items-center gap-1 font-semibold">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      Freelancer
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button
        id="testimonials-prev"
        aria-label="Testimonio anterior"
        class="absolute left-0 sm:-left-3 lg:-left-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-zinc-900/90 border border-zinc-700 text-white hover:bg-secondary-500 hover:border-secondary-400 flex items-center justify-center transition-all duration-300 shadow-xl cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button
        id="testimonials-next"
        aria-label="Testimonio siguiente"
        class="absolute right-0 sm:-right-3 lg:-right-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-zinc-900/90 border border-zinc-700 text-white hover:bg-secondary-500 hover:border-secondary-400 flex items-center justify-center transition-all duration-300 shadow-xl cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <!-- Pagination Dots -->
      <div class="flex justify-center items-center gap-2 mt-6" id="testimonials-dots">
        {
          testimonials.map((_, i) => (
            <button
              data-dot-index={i}
              aria-label={`Ver testimonio ${i + 1}`}
              class="testimonial-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Standard Inactive/Side Card Style (Crisp Light Card matching the design) */
  .testimonial-card.style-inactive {
    background-color: #ffffff;
    color: #18181b;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.1);
    transform: scale(0.94);
    opacity: 0.9;
  }

  .testimonial-card.style-inactive .testimonial-name {
    color: #111827;
  }

  .testimonial-card.style-inactive .testimonial-role {
    color: #6b7280;
  }

  .testimonial-card.style-inactive .testimonial-desc {
    color: #4b5563;
  }

  .testimonial-card.style-inactive .star-icon,
  .testimonial-card.style-inactive .testimonial-quote-icon svg {
    color: #003397;
  }

  .testimonial-card.style-inactive .testimonial-border {
    border-color: #e5e7eb;
    color: #6b7280;
  }

  /* Active Center Card Style (Vibrant Blue Card from mockup) */
  .testimonial-card.style-active {
    background: linear-gradient(145deg, #003db3 0%, #002b80 100%);
    color: #ffffff;
    box-shadow: 0 20px 40px -10px rgba(0, 51, 151, 0.6), 0 0 25px rgba(0, 61, 179, 0.4);
    transform: scale(1.03);
    opacity: 1;
    z-index: 10;
  }

  .testimonial-card.style-active .testimonial-name {
    color: #ffffff;
  }

  .testimonial-card.style-active .testimonial-role {
    color: #bfdbfe;
  }

  .testimonial-card.style-active .testimonial-desc {
    color: #f1f5f9;
  }

  .testimonial-card.style-active .star-icon,
  .testimonial-card.style-active .testimonial-quote-icon svg {
    color: #ffffff;
  }

  .testimonial-card.style-active .testimonial-border {
    border-color: rgba(255, 255, 255, 0.2);
    color: #dbeafe;
  }

  /* Slide Sizing */
  .testimonial-slide {
    width: 100%;
  }

  @media (min-width: 640px) {
    .testimonial-slide {
      width: 50%;
    }
  }

  @media (min-width: 1024px) {
    .testimonial-slide {
      width: 33.333333%;
    }
  }
</style>

<script>
  function initTestimonialsCarousel() {
    const track = document.getElementById("testimonials-track") as HTMLElement | null;
    const prevBtn = document.getElementById("testimonials-prev");
    const nextBtn = document.getElementById("testimonials-next");
    const dots = document.querySelectorAll(".testimonial-dot");
    const slides = document.querySelectorAll(".testimonial-slide");

    if (!track || slides.length === 0) return;

    const total = slides.length;
    let currentIndex = 0;
    let autoPlayTimer: ReturnType<typeof setInterval> | null = null;

    function getVisibleCount(): number {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function updateCarousel() {
      const visibleCount = getVisibleCount();
      const slideWidthPercent = 100 / visibleCount;

      // Calculate translation
      track!.style.transform = `translateX(-${currentIndex * slideWidthPercent}%)`;

      // Active card determination:
      // On desktop (3 visible), the middle card is (currentIndex + 1) % total
      // On tablet/mobile, the primary card is currentIndex % total
      const activeSlideOffset = visibleCount === 3 ? 1 : 0;
      const activeIndex = (currentIndex + activeSlideOffset) % total;

      slides.forEach((slide, idx) => {
        const card = slide.querySelector(".testimonial-card");
        if (!card) return;

        if (idx === activeIndex) {
          card.classList.remove("style-inactive");
          card.classList.add("style-active");
        } else {
          card.classList.remove("style-active");
          card.classList.add("style-inactive");
        }
      });

      // Update dots
      dots.forEach((dot, idx) => {
        const el = dot as HTMLElement;
        if (idx === activeIndex) {
          el.className =
            "testimonial-dot h-2.5 w-7 bg-secondary-500 rounded-full transition-all duration-300 cursor-pointer";
        } else {
          el.className =
            "testimonial-dot h-2.5 w-2.5 bg-zinc-700 hover:bg-zinc-500 rounded-full transition-all duration-300 cursor-pointer";
        }
      });
    }

    function goTo(index: number) {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, total - (visibleCount === 3 ? 1 : 1));
      
      // Loop seamlessly
      if (index < 0) {
        currentIndex = Math.max(0, total - visibleCount);
      } else if (index > total - visibleCount) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      updateCarousel();
    }

    function next() {
      const visibleCount = getVisibleCount();
      if (currentIndex >= total - visibleCount) {
        currentIndex = 0;
      } else {
        currentIndex++;
      }
      updateCarousel();
    }

    function prev() {
      const visibleCount = getVisibleCount();
      if (currentIndex <= 0) {
        currentIndex = Math.max(0, total - visibleCount);
      } else {
        currentIndex--;
      }
      updateCarousel();
    }

    // Event listeners
    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        next();
        resetAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        prev();
        resetAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const targetIdx = Number(dot.getAttribute("data-dot-index") || 0);
        const visibleCount = getVisibleCount();
        const offset = visibleCount === 3 ? 1 : 0;
        goTo(Math.max(0, targetIdx - offset));
        resetAutoplay();
      });
    });

    // Touch / Swipe
    let startX = 0;
    track.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        startX = e.touches[0].clientX;
      },
      { passive: true }
    );

    track.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) next();
          else prev();
          resetAutoplay();
        }
      },
      { passive: true }
    );

    // Autoplay
    function startAutoplay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
      autoPlayTimer = setInterval(next, 4500);
    }

    function stopAutoplay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    function resetAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    const container = document.querySelector(".testimonials-container");
    if (container) {
      container.addEventListener("mouseenter", stopAutoplay);
      container.addEventListener("mouseleave", startAutoplay);
    }

    window.addEventListener("resize", () => {
      updateCarousel();
    });

    // Init
    updateCarousel();
    startAutoplay();
  }

  initTestimonialsCarousel();
  document.addEventListener("astro:page-load", initTestimonialsCarousel);
</script>
