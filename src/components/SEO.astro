---
import { M } from "../config/markets";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs = [] } = Astro.props;

// Datos de la empresa para el mercado que se está compilando.
const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${M.url}/#organization`,
  name: "Grupo Rincón",
  url: `${M.url}/`,
  logo: `${M.url}/Logo/Logo%20blanco.webp`,
  image: `${M.url}/Logo/Logo%20blanco.webp`,
  description: M.defaultDescription,
  telephone: M.phone,
  priceRange: "$$",
  ...(M.address && {
    address: { "@type": "PostalAddress", ...M.address },
  }),
  areaServed: [
    ...M.cities.map((name) => ({ "@type": "City", name })),
    { "@type": "Country", name: M.country },
  ],
  sameAs: [
    "https://www.facebook.com/profile.php?id=61586834372570",
    "https://www.instagram.com/gruporinconve/",
    "https://www.tiktok.com/@gruporinconve",
  ],
};

const breadcrumbSchema =
  breadcrumbs.length >= 2
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((breadcrumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: breadcrumb.name,
          item: breadcrumb.url,
        })),
      }
    : null;
---

<!-- Inyección del JSON-LD en el HTML sin que Astro altere las comillas o caracteres -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schemaData)}
/>

{
  breadcrumbSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  )
}
