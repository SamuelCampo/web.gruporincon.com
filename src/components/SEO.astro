---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Define los datos de tu empresa u organización
const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Grupo Rincón",
  url: "https://www.gruporincon.com.co/",
  logo: "https://www.gruporincon.com.co/Logo/Logo%20blanco.webp",
  image: "https://www.gruporincon.com.co/Logo/Logo%20blanco.webp",
  description:
    "Agencia de desarrollo de software, páginas web y soluciones digitales integrales para PYMEs en Colombia y Venezuela.",
  telephone: "+584262590251",
  priceRange: "$$",
  sameAs: [
    "https://www.facebook.com/profile.php?id=61586834372570",
    "https://www.instagram.com/gruporinconve/",
    "https://www.tiktok.com/@gruporinconve",
  ],
};

const breadcrumbSchema =
  breadcrumbs.length >= 2
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((breadcrumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: breadcrumb.name,
          item: breadcrumb.url,
        })),
      }
    : null;
---

<!-- Inyección del JSON-LD en el HTML sin que Astro altere las comillas o caracteres -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schemaData)}
/>

{
  breadcrumbSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  )
}
