---
import Icon, { type IconName } from "./Icon.astro";
import { TONES, type Tone } from "./tones";

interface Props {
  icon: IconName;
  tone?: Tone;
  size?: "md" | "lg";
}
const { icon, tone = "blue", size = "md" } = Astro.props;
const box = size === "lg" ? "w-14 h-14 rounded-2xl" : "w-11 h-11 rounded-xl";
const ic = size === "lg" ? "w-6 h-6" : "w-5 h-5";
---

<div class={`${box} border flex items-center justify-center shrink-0 ${TONES[tone].tile}`}>
  <Icon name={icon} class={ic} />
</div>
