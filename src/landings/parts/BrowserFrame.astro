---
/** Marco de navegador para mockups e ilustraciones. */
interface Props {
  url?: string;
  class?: string;
}
const { url = "gruporincon.com.ve", class: className = "" } = Astro.props;
---

<div
  class={`rounded-2xl border border-white/10 bg-zinc-900/90 shadow-2xl shadow-black/60 overflow-hidden ${className}`}
>
  <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-zinc-900">
    <span class="w-2.5 h-2.5 rounded-full bg-rose-400/70"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70"></span>
    <span
      class="ml-3 flex-1 max-w-[16rem] truncate text-[10px] text-zinc-500 bg-black/40 rounded-md px-3 py-1 font-mono"
      >{url}</span
    >
  </div>
  <slot />
</div>
