---
import Icon from "./Icon.astro";
import { waLink } from "../../config/markets";
import type { LandingData } from "../data";

interface Props {
  landing: LandingData;
}
const { landing } = Astro.props;
const { hero } = landing;
---

<section class="relative overflow-hidden bg-black">
  <div
    class="absolute top-[-10%] left-[-10%] w-[55%] h-[60%] rounded-full bg-secondary-500/15 blur-[140px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[60%] rounded-full bg-emerald-500/10 blur-[140px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20 lg:pt-40 lg:pb-28 grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-14 lg:gap-10 items-center"
  >
    <div>
      <nav aria-label="Ruta de navegación" class="mb-6 text-xs text-zinc-500">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2 text-zinc-700">/</span>
        <span class="text-zinc-400">{landing.breadcrumb}</span>
      </nav>
      <div
        class="inline-flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-1.5 rounded-full mb-7"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span
          class="text-xs font-semibold text-zinc-300 tracking-widest uppercase font-display"
          >{hero.badge}</span
        >
      </div>
      <h1
        class="text-4xl sm:text-5xl xl:text-6xl font-black text-white leading-[1.05] tracking-tight font-display"
      >
        {hero.h1}{" "}
        <span
          class="bg-gradient-to-r from-secondary-300 via-blue-300 to-emerald-300 bg-clip-text text-transparent"
          >{hero.highlight}</span
        >
      </h1>
      <p class="mt-6 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-xl">
        {hero.intro}
      </p>
      <div class="mt-9 flex flex-col sm:flex-row items-start gap-4">
        <a
          href={waLink(hero.waText)}
          target="_blank"
          rel="noopener noreferrer"
          class="glow-btn inline-flex items-center gap-2.5 bg-secondary-500 hover:bg-secondary-600 text-white px-8 py-4 rounded-full text-sm font-bold tracking-wide transition-all duration-300 shadow-lg shadow-secondary-500/30"
        >
          <Icon name="chat" class="w-4 h-4" /> Cotizar por WhatsApp
        </a>
        <a
          href="#preguntas-frecuentes"
          class="inline-flex items-center gap-2 border border-white/20 hover:border-white/40 text-white/80 hover:text-white px-8 py-4 rounded-full text-sm font-semibold tracking-wide transition-all duration-300 bg-white/5 hover:bg-white/10"
        >
          Preguntas frecuentes
        </a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-3 text-xs font-semibold text-zinc-300">
        <li class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <span class="text-white font-black font-display text-sm">+10</span> años
        </li>
        <li class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <span class="text-white font-black font-display text-sm">+100</span> proyectos
        </li>
        <li class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <span class="text-white font-black font-display text-sm">8</span> países
        </li>
      </ul>
    </div>
    <div class="relative">
      <slot name="visual" />
    </div>
  </div>
</section>
