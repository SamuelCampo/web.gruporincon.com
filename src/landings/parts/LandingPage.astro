---
/**
 * Envoltura común de las landings por mercado: Layout, datos estructurados,
 * y las secciones finales (casos, proceso, preguntas frecuentes y CTA).
 * Las secciones propias de cada landing van en el <slot />.
 */
import Layout from "../../layouts/Layout.astro";
import Process from "../../components/Process.astro";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { M, waLink, marketUrl } from "../../config/markets";
import {
  successCases,
  getSuccessCaseHref,
  isExternalSuccessCase,
} from "../../data/successCases";
import type { LandingData } from "../data";

interface Props {
  landing: LandingData;
}

const { landing } = Astro.props;
const pageUrl = marketUrl(`/${landing.slug}/`);

const breadcrumbs = [
  { name: "Inicio", url: marketUrl("/") },
  { name: landing.breadcrumb, url: pageUrl },
];

const cases = landing.caseSlugs
  .map((slug) => successCases.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: landing.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: landing.service.name,
  serviceType: landing.service.serviceType,
  url: pageUrl,
  provider: { "@id": `${M.url}/#organization` },
  areaServed: [
    ...M.cities.map((name) => ({ "@type": "City", name })),
    { "@type": "Country", name: M.country },
  ],
};
---

<Layout
  title={landing.title}
  description={landing.description}
  breadcrumbs={breadcrumbs}
  markets={[landing.market]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <slot />

  <!-- CASOS -->
  <section class="bg-black py-20 lg:py-28 relative overflow-hidden">
    <div
      class="absolute -top-20 right-0 w-[480px] h-[480px] rounded-full bg-secondary-500/10 blur-[140px] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <SectionHeading
          eyebrow="Portafolio"
          title={landing.casesTitle}
          intro={landing.casesIntro}
        />
        <a
          href="/casos-de-exito/"
          class="mb-12 lg:mb-16 inline-flex items-center gap-2 text-sm font-semibold text-secondary-300 hover:text-white transition-colors shrink-0"
        >
          Ver todos los casos <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
        {
          cases.map((item) => (
            <a
              href={getSuccessCaseHref(item)}
              target={isExternalSuccessCase(item) ? "_blank" : undefined}
              rel={isExternalSuccessCase(item) ? "noopener noreferrer" : undefined}
              class="group relative block aspect-[4/5] rounded-3xl overflow-hidden border border-white/10"
            >
              <picture>
                <source srcset={`${item.image}.avif`} type="image/avif" />
                <source srcset={`${item.image}.webp`} type="image/webp" />
                <img
                  src={`${item.image}.webp`}
                  alt={`Proyecto ${item.name}`}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-6">
                <span class="inline-block text-[10px] font-bold uppercase tracking-widest text-white/80 bg-white/10 backdrop-blur px-3 py-1 rounded-full mb-3">
                  {item.industry}
                  {item.locationLabel && ` · ${item.locationLabel}`}
                </span>
                <h3 class="text-2xl font-black text-white font-display tracking-tight">
                  {item.name}
                </h3>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary-300 group-hover:text-white transition-colors">
                  Ver proyecto <Icon name="arrow" class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Process />

  <!-- FAQ -->
  <section id="preguntas-frecuentes" class="bg-zinc-950 py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-12">
      <div>
        <SectionHeading
          eyebrow="Preguntas frecuentes"
          title="Lo que suelen preguntarnos"
        />
        <div class="hidden lg:block glass-panel border border-white/10 rounded-3xl p-6 -mt-4">
          <p class="text-sm text-zinc-400 mb-4">¿No encuentras tu pregunta?</p>
          <a
            href={waLink(landing.cta.waText)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1fb857] text-zinc-950 font-bold text-sm px-5 py-3 rounded-full transition-colors"
          >
            <Icon name="chat" class="w-4 h-4" /> Pregúntanos por WhatsApp
          </a>
        </div>
      </div>
      <div>
        <div class="space-y-3">
          {
            landing.faqs.map((faq) => (
              <details class="group rounded-2xl border border-white/10 bg-black/30 overflow-hidden open:border-secondary-500/40">
                <summary class="flex items-center justify-between gap-5 p-5 sm:p-6 cursor-pointer list-none">
                  <h3 class="text-sm sm:text-base font-bold text-zinc-200 font-display">
                    {faq.question}
                  </h3>
                  <span
                    class="w-8 h-8 rounded-full border border-white/10 bg-white/[0.04] flex items-center justify-center shrink-0 text-zinc-400 text-lg leading-none transition-transform group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <div class="px-5 sm:px-6 pb-6 -mt-1">
                  <p class="text-sm text-zinc-400 leading-relaxed">{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
        <div class="mt-10">
          <p class="text-xs font-bold text-zinc-500 uppercase tracking-widest font-display mb-4">
            También te puede interesar
          </p>
          <ul class="flex flex-wrap gap-3">
            {
              landing.related.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-2 text-sm text-zinc-300 hover:text-white bg-white/5 border border-white/10 hover:border-secondary-500/40 px-4 py-2 rounded-full transition-colors"
                  >
                    {link.label} <Icon name="arrow" class="w-3.5 h-3.5" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-black py-20 lg:py-28 px-4 sm:px-6 lg:px-8">
    <div
      class="relative max-w-6xl mx-auto overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-secondary-600 via-secondary-800 to-black px-6 py-16 sm:px-12 lg:py-20 text-center reveal"
    >
      <div
        class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-[100px] pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-blue-400/20 blur-[100px] pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-black text-white font-display tracking-tight leading-tight max-w-3xl mx-auto"
        >
          {landing.cta.title}
        </h2>
        <p class="text-white/70 text-base sm:text-lg leading-relaxed mt-5 max-w-2xl mx-auto">
          {landing.cta.text}
        </p>
        <a
          href={waLink(landing.cta.waText)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center gap-2.5 bg-white hover:bg-zinc-100 text-secondary-600 px-8 py-4 rounded-full text-sm font-bold tracking-wide transition-all duration-300 shadow-lg shadow-black/30"
        >
          <Icon name="chat" class="w-4 h-4" /> Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
