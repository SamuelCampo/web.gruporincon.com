---
import Layout from "../layouts/Layout.astro";
import {
  getSuccessCaseHref,
  isExternalSuccessCase,
  successCases,
} from "../data/successCases";

const canonicalBase = Astro.site || Astro.url;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Casos de éxito de Grupo Rincon",
  description:
    "Proyectos digitales desarrollados por Grupo Rincon para empresas y organizaciones de distintas industrias.",
  url: new URL("/casos-de-exito/", canonicalBase).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: successCases.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: new URL(getSuccessCaseHref(item), canonicalBase).toString(),
    })),
  },
};
---

<Layout
  title="Casos de éxito en desarrollo web y software | Grupo Rincon"
  description="Conoce los proyectos digitales que Grupo Rincon ha desarrollado para empresas de tecnología, educación, transporte, logística, inmobiliaria y organizaciones sociales."
  socialImage="/casos-de-exito-social.avif"
  socialImageAlt="Casos de éxito en desarrollo web y software de Grupo Rincon"
  socialImageWidth={1200}
  socialImageHeight={630}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    {
      name: "Casos de éxito",
      url: new URL("/casos-de-exito/", canonicalBase).toString(),
    },
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionSchema)}
  />

  <section
    class="relative overflow-hidden bg-black pt-36 pb-20 sm:pt-40 sm:pb-24 lg:pt-44 lg:pb-28"
  >
    <div
      class="absolute left-1/2 top-0 h-[520px] w-[780px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] bg-size-[30px_30px] opacity-30 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol class="flex items-center gap-2 text-xs font-semibold text-zinc-500">
          <li><a href="/" class="transition-colors hover:text-white">Inicio</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">Casos de éxito</li>
        </ol>
      </nav>

      <div class="max-w-4xl reveal">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2"
        >
          <span class="h-2 w-2 rounded-full bg-secondary-400"></span>
          <span
            class="font-display text-[11px] font-bold uppercase tracking-[0.2em] text-secondary-300"
          >
            Trabajo que genera confianza
          </span>
        </div>
        <h1
          class="max-w-4xl font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-7xl"
        >
          Casos de éxito en
          <span
            class="bg-linear-to-r from-blue-400 via-secondary-300 to-indigo-400 bg-clip-text text-transparent"
          >desarrollo web y software.</span
          >
        </h1>
        <p
          class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg"
        >
          Conoce una selección de soluciones digitales creadas para empresas y
          organizaciones de distintas industrias. Cada proyecto responde a un
          reto, una audiencia y un objetivo de negocio diferente.
        </p>
      </div>

      <div
        class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-white/10 pt-7 text-sm text-zinc-400 reveal"
      >
        <span><strong class="text-2xl text-white">{successCases.length}</strong> proyectos destacados</span>
        <span class="hidden h-5 w-px bg-white/10 sm:block"></span>
        <span><strong class="text-2xl text-white">7</strong> industrias representadas</span>
        <span class="hidden h-5 w-px bg-white/10 sm:block"></span>
        <span><strong class="text-2xl text-white">3</strong> países confirmados</span>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-zinc-950 py-20 lg:py-28">
    <div
      class="absolute right-0 top-1/3 h-96 w-96 rounded-full bg-secondary-600/5 blur-[120px] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between lg:mb-16 reveal"
      >
        <div>
          <span
            class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
            >Nuestro trabajo</span
          >
          <h2
            class="mt-3 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
          >
            Todos los casos de éxito
          </h2>
        </div>
        <p class="max-w-lg text-sm leading-relaxed text-zinc-500 sm:text-right">
          Los proyectos con caso detallado se abren dentro de Grupo Rincon. Los
          demás te llevan al sitio publicado del cliente.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
        {
          successCases.map((item, index) => {
            const href = getSuccessCaseHref(item);
            const external = isExternalSuccessCase(item);

            return (
              <article
                class="group reveal overflow-hidden rounded-3xl border border-white/[0.07] bg-zinc-900/45 transition-all duration-300 hover:-translate-y-1 hover:border-secondary-500/35 hover:shadow-2xl hover:shadow-secondary-900/20"
                style={`animation-delay: ${index * 70}ms`}
              >
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="block cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400"
                  aria-label={`${external ? "Visitar el proyecto" : "Ver el caso de éxito de"} ${item.name}`}
                >
                  <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900">
                    <picture>
                      <source srcset={`${item.image}.avif`} type="image/avif" />
                      <source srcset={`${item.image}.webp`} type="image/webp" />
                      <img
                        src={`${item.image}.webp`}
                        width="1000"
                        height="625"
                        alt={`Proyecto digital de ${item.name}`}
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
                        loading="lazy"
                      />
                    </picture>
                    <div class="absolute inset-0 bg-linear-to-t from-black/45 via-transparent to-transparent" />
                    <div class="absolute left-5 top-5 flex items-center gap-2">
                      <span class="rounded-full border border-white/15 bg-black/55 px-3 py-1.5 font-display text-[10px] font-bold uppercase tracking-widest text-white backdrop-blur-md">
                        {item.country
                          ? `${item.industry} · ${item.country}`
                          : item.industry}
                      </span>
                    </div>
                    <span class="absolute right-5 top-5 flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-black/45 font-display text-[10px] font-black text-white/70 backdrop-blur-md">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>

                  <div class="p-6 sm:p-8">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="font-display text-2xl font-black tracking-tight text-white sm:text-3xl">
                          {item.name}
                        </h3>
                        <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400 sm:text-base">
                          {item.description}
                        </p>
                      </div>
                      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-zinc-300 transition-all duration-300 group-hover:border-secondary-500/40 group-hover:bg-secondary-500/15 group-hover:text-white">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          {external ? (
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5h5m0 0v5m0-5L10 14M19 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h4" />
                          ) : (
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                          )}
                        </svg>
                      </span>
                    </div>
                    <div class="mt-6 flex items-center justify-between border-t border-white/[0.07] pt-5">
                      <span class="font-display text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-secondary-300 transition-colors duration-300">
                        {external ? "Visitar proyecto" : "Ver caso completo"}
                      </span>
                      <span class="text-[11px] text-zinc-600">
                        {external ? "Sitio del cliente" : "Dentro de Grupo Rincon"}
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-white/[0.06] bg-black py-20 lg:py-28">
    <div
      class="absolute bottom-0 left-1/2 h-80 w-[680px] -translate-x-1/2 rounded-full bg-secondary-500/10 blur-[130px] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal">
      <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">
        Tu proyecto puede ser el próximo
      </span>
      <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Construyamos una solución que haga crecer tu negocio.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">
        Cuéntanos qué necesitas resolver y te ayudaremos a convertirlo en una
        experiencia digital rápida, útil y preparada para crecer.
      </p>
      <a
        href="https://wa.me/584262590251"
        target="_blank"
        rel="noopener noreferrer"
        class="glow-btn mt-8 inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-all duration-300 hover:bg-secondary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-300"
      >
        Hablemos de tu proyecto
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
