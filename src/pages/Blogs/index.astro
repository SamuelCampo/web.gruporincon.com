---
import Layout from "../../layouts/Layout.astro";

const siteURL = Astro.site ?? new URL("https://www.gruporincon.com.co");
const breadcrumbs = [
  { name: "Inicio", url: new URL("/", siteURL).toString() },
  { name: "Blog", url: new URL(Astro.url.pathname, siteURL).toString() },
];
---

<Layout
  title="Blog de páginas web y WordPress | Grupo Rincón"
  description="Guías sencillas sobre páginas web, WordPress y crecimiento digital para negocios en Venezuela y Colombia."
  breadcrumbs={breadcrumbs}
>
  <section class="relative overflow-hidden pt-40 pb-24 sm:pt-48 sm:pb-32">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(0,51,151,.25),transparent_42%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-5 text-center sm:px-8">
      <p
        class="mb-5 text-sm font-bold uppercase tracking-[0.25em] text-secondary-300"
      >
        Recursos para crecer en internet
      </p>
      <h1
        class="font-display text-4xl font-black leading-tight text-white sm:text-6xl"
      >
        Blog de páginas web y WordPress
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-300">
        Consejos claros y prácticos para emprendedores y empresas de Venezuela y
        Colombia.
      </p>

      <article
        class="mx-auto mt-16 max-w-3xl overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] p-7 text-left shadow-2xl shadow-blue-950/20 sm:p-10"
      >
        <a
          href="/blogs/como-crear-una-pagina-web-gratis-con-wordpress/"
          class="mb-7 block overflow-hidden rounded-2xl"
        >
          <img
            src="/blogs/como-crear-pagina-web-gratis-wordpress.avif"
            alt="Cómo crear una página web gratis con WordPress"
            width="1200"
            height="630"
            class="h-auto w-full transition-transform duration-500 hover:scale-[1.02]"
            loading="eager"
          />
        </a>
        <div
          class="mb-5 flex flex-wrap items-center gap-3 text-sm text-zinc-400"
        >
          <span
            class="rounded-full bg-secondary-500/20 px-3 py-1 font-semibold text-secondary-300"
            >WordPress</span
          >
          <time datetime="2026-09-17">17 de septiembre de 2026</time>
          <span aria-hidden="true">·</span>
          <span>10 min de lectura</span>
        </div>
        <h2
          class="font-display text-2xl font-extrabold leading-tight text-white sm:text-3xl"
        >
          <a
            class="transition-colors hover:text-secondary-300"
            href="/Blogs/como-crear-una-pagina-web-gratis-con-wordpress/"
            >Cómo crear una página web gratis con WordPress desde Venezuela o
            Colombia</a
          >
        </h2>
        <p class="mt-4 text-base leading-7 text-zinc-300">
          Una guía paso a paso para elegir el nombre, crear el sitio, diseñar
          las páginas básicas y publicarlo sin conocimientos técnicos.
        </p>
        <a
          class="mt-7 inline-flex items-center gap-2 font-bold text-secondary-300 hover:text-white"
          href="/Blogs/como-crear-una-pagina-web-gratis-con-wordpress/"
          >Leer la guía <span aria-hidden="true">→</span></a
        >
      </article>
    </div>
  </section>
</Layout>
