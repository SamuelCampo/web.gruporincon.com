---
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL("/casos-de-exito/job-and-go/", canonicalBase).toString();
const imageUrl = new URL("/casos/jobandgo/social.webp", canonicalBase).toString();

const title = "Job&Go: app de empleo para Triangle RRHH | Grupo Rincón";
const description =
  "Así creamos Job&Go, la app de empleo de Triangle Solutions RRHH: ofertas diarias, filtros, chat con consultores y perfil profesional.";

const faqs = [
  {
    question: "¿Qué es Job&Go?",
    answer:
      "Job&Go es la app de empleo de Triangle Solutions RRHH, una empresa de recursos humanos de Sevilla, España. Con ella, el candidato ve ofertas nuevas cada día y las filtra. Se inscribe con un toque y habla directo con el consultor.",
  },
  {
    question: "¿Qué hizo Grupo Rincón en el proyecto Job&Go?",
    answer:
      "Grupo Rincón diseñó y desarrolló la app. Eso incluye el diseño de las pantallas, las ofertas y sus filtros, y el chat entre consultores y candidatos. También el perfil profesional y el historial de postulaciones.",
  },
  {
    question: "¿Cuánto cuesta desarrollar una app de empleo como Job&Go en Venezuela o Colombia?",
    answer:
      "Depende del alcance. Influyen el número de pantallas, la conexión con tu sistema de RR. HH., el chat, las notificaciones y la publicación en las tiendas. Primero definimos contigo una versión inicial en una consultoría gratuita. Luego te damos un precio cerrado por fases.",
  },
  {
    question: "¿Una app de empleo puede conectarse con el software de RR. HH. que ya uso?",
    answer:
      "Sí. Una app a la medida puede leer las ofertas y los candidatos de tu sistema actual. Tu equipo sigue usando su herramienta de siempre y la app se actualiza sola.",
  },
  {
    question: "¿Ofrecen mantenimiento después de publicar la app?",
    answer:
      "Sí. Tenemos planes de soporte y mantenimiento a la medida. Adaptamos la app a cada nueva versión de iOS y Android y corregimos errores. También mejoramos la velocidad y sumamos funciones según el uso real.",
  },
];

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline:
    "Job&Go: la app que conecta candidatos y consultores de Triangle Solutions RRHH",
  description,
  image: imageUrl,
  inLanguage: "es",
  mainEntityOfPage: pageUrl,
  author: {
    "@type": "Organization",
    name: "Grupo Rincon",
    url: new URL("/", canonicalBase).toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "Grupo Rincon",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "MobileApplication",
    name: "Job&Go",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Android, iOS",
    creator: { "@type": "Organization", name: "Grupo Rincon" },
    publisher: { "@type": "Organization", name: "Triangle Solutions RRHH" },
  },
  contentLocation: { "@type": "Country", name: "España" },
  audience: {
    "@type": "BusinessAudience",
    geographicArea: [
      { "@type": "Country", name: "Venezuela" },
      { "@type": "Country", name: "Colombia" },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const facts = [
  { label: "Cliente", value: "Triangle Solutions RRHH" },
  { label: "Sector", value: "Recursos humanos y empleo" },
  { label: "Ubicación", value: "Sevilla, España" },
  { label: "Producto", value: "App móvil de empleo Job&Go" },
  { label: "Plataformas", value: "Android e iOS" },
  { label: "Servicio", value: "Diseño UX/UI y desarrollo de app" },
];

const comparison = [
  {
    step: "Buscar ofertas",
    before: "Revisar varios portales de empleo",
    after: "Un listado propio, nuevo cada día",
  },
  {
    step: "Encontrar el puesto",
    before: "Leer todas las ofertas una a una",
    after: "Buscador y filtros por puesto o ciudad",
  },
  {
    step: "Postularse",
    before: "Enviar el CV por correo en cada oferta",
    after: "Botón «Inscribirme» con el perfil guardado",
  },
  {
    step: "Coordinar la entrevista",
    before: "Llamadas y correos sueltos",
    after: "Chat directo con el consultor",
  },
  {
    step: "Completar datos",
    before: "Documentos pedidos a última hora",
    after: "Perfil con barra de progreso y avisos",
  },
  {
    step: "Seguir el proceso",
    before: "Sin saber en qué va la postulación",
    after: "Historial de postulaciones en la app",
  },
];

const problems = [
  "Candidatos que debían revisar varios portales para encontrar las ofertas de la empresa.",
  "Coordinación de entrevistas por llamadas y correos que se perdían entre mensajes.",
  "Perfiles incompletos que retrasaban la contratación por falta de datos o documentos.",
  "Poca visibilidad para el candidato sobre el estado de sus postulaciones.",
];

const features = [
  {
    number: "01",
    title: "Ofertas diarias",
    description:
      "Ofertas nuevas con puesto, ciudad y fecha. Cada una abre una ficha con fecha de inicio, jornada, salario y funciones.",
  },
  {
    number: "02",
    title: "Filtros personalizados",
    description:
      "Un buscador y filtros para dar con el puesto por palabra, ciudad o tipo de trabajo. Sin revisar todo el listado.",
  },
  {
    number: "03",
    title: "Comunicación directa",
    description:
      "Un chat entre consultor y candidato. Sirve para coordinar entrevistas y resolver dudas al momento.",
  },
  {
    number: "04",
    title: "Perfil profesional",
    description:
      "Datos personales, CV, disponibilidad y documentos. Una barra de progreso anima a completarlo.",
  },
  {
    number: "05",
    title: "Inscripción en un toque",
    description:
      "El botón «Inscribirme» siempre está a la vista. El candidato se postula sin llenar formularios otra vez.",
  },
  {
    number: "06",
    title: "Historial y marca",
    description:
      "El candidato ve sus postulaciones. También llega a las redes de Triangle: LinkedIn, Infojobs, Facebook, TikTok e Instagram.",
  },
];

const flow = [
  {
    number: "01",
    title: "Encontrar",
    description:
      "El candidato abre la app, busca y filtra entre las ofertas publicadas ese día.",
  },
  {
    number: "02",
    title: "Postular",
    description:
      "Revisa la ficha de la oferta y se inscribe con un toque usando su perfil guardado.",
  },
  {
    number: "03",
    title: "Conversar",
    description:
      "El consultor le escribe por la app para coordinar la entrevista y pedir lo que falte.",
  },
  {
    number: "04",
    title: "Contratar",
    description:
      "Con el perfil y la documentación completos, el proceso de alta avanza sin fricción.",
  },
];

const screens = [
  {
    src: "/casos/jobandgo/app-splash",
    width: 440,
    alt: "Pantalla de carga de la app Job&Go con el logotipo de Triangle Solutions RRHH",
    caption: "Inicio de marca",
  },
  {
    src: "/casos/jobandgo/app-ofertas",
    width: 440,
    alt: "Listado de ofertas de empleo en Sevilla con buscador y filtros en Job&Go",
    caption: "Ofertas y filtros",
  },
  {
    src: "/casos/jobandgo/app-detalle",
    width: 537,
    alt: "Detalle de una oferta de empleo con salario, modalidad y botón Inscribirme en Job&Go",
    caption: "Detalle e inscripción",
  },
  {
    src: "/casos/jobandgo/app-perfil",
    width: 440,
    alt: "Perfil del candidato con progreso, CV, disponibilidad y documentación en Job&Go",
    caption: "Perfil profesional",
  },
];

const services = [
  {
    href: "/servicios/desarrollo-apps-moviles/",
    tag: "Desarrollo de apps",
    title: "Desarrollo de apps móviles a la medida",
    copy: "Diseñamos y programamos apps para Android e iOS. Te acompañamos desde la primera versión hasta la publicación en las tiendas.",
  },
  {
    href: "/servicios/automatizacion-desarrollo/",
    tag: "Software y mantenimiento",
    title: "Software a medida, integraciones y mantenimiento",
    copy: "Conectamos tu app con tus sistemas. Luego la mantenemos al día con soporte, actualizaciones y nuevas funciones.",
  },
];
---

<Layout
  title={title}
  description={description}
  socialImage="/casos/jobandgo/social.webp"
  socialImageAlt="Pantallas de la app de empleo Job&Go desarrollada por Grupo Rincón"
  socialImageWidth={1200}
  socialImageHeight={630}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    {
      name: "Casos de éxito",
      url: new URL("/casos-de-exito/", canonicalBase).toString(),
    },
    { name: "Job&Go", url: pageUrl },
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(caseSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <!-- Hero -->
  <section
    class="relative overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44"
  >
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[560px] w-[820px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] bg-size-[30px_30px] opacity-25"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol
          class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500"
        >
          <li>
            <a href="/" class="transition-colors hover:text-white">Inicio</a>
          </li><li aria-hidden="true" class="text-zinc-700">/</li>
          <li>
            <a
              href="/casos-de-exito/"
              class="transition-colors hover:text-white">Casos de éxito</a
            >
          </li><li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">Job&amp;Go</li>
        </ol>
      </nav>
      <div
        class="grid items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16"
      >
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span
              class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300"
              >Caso de éxito</span
            >
            <span class="font-display text-xs font-semibold text-zinc-500"
              >España · Recursos humanos · App móvil</span
            >
          </div>
          <h1
            class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            Job&amp;Go: una app de empleo que pone el trabajo
            <span
              class="bg-linear-to-r from-blue-400 via-secondary-300 to-indigo-400 bg-clip-text text-transparent"
            >
              a un clic del candidato.</span
            >
          </h1>
          <p
            class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg"
          >
            Creamos Job&amp;Go para Triangle Solutions RRHH, una empresa de
            selección de personal de Sevilla. En una sola app, el candidato ve
            ofertas, se postula y habla con su consultor.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              ["Android", "iOS", "UX/UI", "Mensajería", "RR. HH."].map(
                (item) => (
                  <span class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-semibold text-zinc-300">
                    {item}
                  </span>
                ),
              )
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/servicios/desarrollo-apps-moviles/"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-secondary-500 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-secondary-600"
              >Quiero una app así <span aria-hidden="true">→</span></a
            >
            <a
              href="#funciones"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-colors hover:border-secondary-500/40"
              >Ver funciones</a
            >
          </div>
        </div>
        <div class="reveal">
          <div
            class="relative overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl shadow-secondary-950/40"
          >
            <picture>
              <source srcset="/portfolio/JobAndGo.avif" type="image/avif" />
              <img
                src="/portfolio/JobAndGo.webp"
                width="1600"
                height="1000"
                alt="Pantallas de Job&Go: perfil del candidato, listado de ofertas y detalle de una oferta"
                class="aspect-[16/10] h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resumen citable + ficha -->
  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-24">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >En resumen</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          ¿Qué es Job&amp;Go?
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-300 sm:text-lg">
          <strong class="text-white">Job&amp;Go</strong> es la app de empleo de
          Triangle Solutions RRHH, desarrollada por Grupo Rincón. Une a
          empresas y candidatos en menos pasos. El candidato encuentra una
          oferta, se inscribe con un toque y habla con el consultor. Todo desde
          el mismo teléfono.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          El proyecto muestra algo simple. Una empresa de RR. HH. puede cambiar
          portales, llamadas y correos por un solo canal propio. Ese canal
          lleva su marca y acompaña al candidato hasta la contratación.
        </p>
      </div>
      <div
        class="reveal overflow-hidden rounded-3xl border border-white/[0.07] bg-black/60"
      >
        <table class="w-full text-left">
          <caption class="sr-only">Ficha del proyecto Job&amp;Go</caption>
          <tbody class="divide-y divide-white/[0.07]">
            {
              facts.map((fact) => (
                <tr>
                  <th
                    scope="row"
                    class="w-2/5 px-5 py-4 align-top font-display text-[10px] font-bold uppercase tracking-widest text-zinc-500 sm:px-6"
                  >
                    {fact.label}
                  </th>
                  <td class="px-5 py-4 text-sm font-semibold leading-snug text-white sm:px-6">
                    {fact.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Reto -->
  <section class="bg-black py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >El reto</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Reducir las barreras entre una oferta publicada y una persona
          contratada.
        </h2>
      </div>
      <div class="reveal">
        <p class="text-base leading-relaxed text-zinc-400 sm:text-lg">
          En selección de personal, la velocidad decide. Una vacante de
          almacén o de oficina se cubre en pocos días. Quien responde primero
          suele quedarse con el puesto.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
          Antes, la información estaba repartida entre portales, llamadas y
          correos. Triangle Solutions RRHH necesitaba un canal propio. Debía
          ser rápido y fácil para candidatos y consultores.
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            problems.map((problem) => (
              <div class="rounded-2xl border border-white/[0.07] bg-zinc-900/45 p-5 text-sm leading-relaxed text-zinc-300">
                {problem}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Comparativa -->
  <section class="bg-black pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-3xl reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >Antes y después</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          ¿Qué cambia con una app de empleo propia?
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Cada paso de la búsqueda de empleo se hace en menos tiempo. Esta
          tabla compara el proceso habitual con el de Job&amp;Go.
        </p>
      </div>
      <div
        class="reveal overflow-x-auto rounded-3xl border border-white/[0.07] bg-zinc-900/45"
      >
        <table class="w-full min-w-[560px] text-left text-sm">
          <caption class="sr-only">
            Comparación entre el proceso tradicional y Job&amp;Go
          </caption>
          <thead>
            <tr class="border-b border-white/[0.07]">
              <th
                scope="col"
                class="px-5 py-4 font-display text-[10px] font-bold uppercase tracking-widest text-zinc-500 sm:px-6"
                >Paso</th
              >
              <th
                scope="col"
                class="px-5 py-4 font-display text-[10px] font-bold uppercase tracking-widest text-zinc-500 sm:px-6"
                >Proceso tradicional</th
              >
              <th
                scope="col"
                class="px-5 py-4 font-display text-[10px] font-bold uppercase tracking-widest text-secondary-300 sm:px-6"
                >Con Job&amp;Go</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.07]">
            {
              comparison.map((row) => (
                <tr>
                  <th
                    scope="row"
                    class="px-5 py-4 font-display text-sm font-bold text-white sm:px-6"
                  >
                    {row.step}
                  </th>
                  <td class="px-5 py-4 leading-relaxed text-zinc-500 sm:px-6">
                    {row.before}
                  </td>
                  <td class="px-5 py-4 leading-relaxed text-zinc-200 sm:px-6">
                    {row.after}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Funciones -->
  <section id="funciones" class="scroll-mt-28 bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-3xl text-center reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >La solución</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Seis funciones que acortan el camino hacia el empleo.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Cada pantalla lleva al candidato a lo importante: postularse o
          responder al consultor. Y lo hace con pocos toques.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((item, index) => (
            <article
              class="reveal rounded-3xl border border-white/[0.07] bg-black/40 p-7 sm:p-8"
              style={`animation-delay: ${index * 60}ms`}
            >
              <>
                <span class="font-display text-xs font-black tracking-widest text-secondary-400">
                  {item.number}
                </span>
                <h3 class="mt-6 font-display text-xl font-black text-white">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">
                  {item.description}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pantallas -->
  <section class="relative overflow-hidden bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >La herramienta</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una interfaz clara, con la identidad de Triangle en cada pantalla.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Tarjetas limpias y letra fácil de leer. El rojo de la marca solo
          aparece en las acciones clave. El menú inferior lleva a Ofertas,
          Mensajes, Triangle, Historial y Mi perfil.
        </p>
      </div>
      <div
        class="reveal grid grid-cols-2 gap-4 rounded-3xl border border-white/[0.07] bg-zinc-900/35 p-5 sm:gap-6 sm:p-8 lg:grid-cols-4"
      >
        {
          screens.map((screen) => (
            <figure class="flex flex-col items-center">
              <picture class="w-full">
                <source srcset={`${screen.src}.avif`} type="image/avif" />
                <img
                  src={`${screen.src}.webp`}
                  width={screen.width}
                  height="954"
                  alt={screen.alt}
                  loading="lazy"
                  class="mx-auto h-auto max-h-[520px] w-auto rounded-2xl border border-white/10 shadow-2xl"
                />
              </picture>
              <figcaption class="mt-4 font-display text-xs font-bold uppercase tracking-widest text-zinc-400">
                {screen.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Flujo -->
  <section class="bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-3xl text-center reveal">
