---
import FaktuCaseVisual from "../../components/FaktuCaseVisual.astro";
import { waLink } from "../../config/markets";
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL("/casos-de-exito/faktu/", canonicalBase).toString();
const companyUrl = "https://faktu.net/";
const appUrl = "https://app.faktu.net/";

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Faktu: plataforma de gestión de cobranza y contratación en línea",
  description:
    "Caso de éxito de Faktu en Chile: una plataforma para contratar servicios, gestionar facturas, controlar la cobranza y automatizar tareas, desarrollada de forma continua durante cuatro años.",
  mainEntityOfPage: pageUrl,
  image: new URL("/casos/faktu/logo-color.png", canonicalBase).toString(),
  author: {
    "@type": "Organization",
    name: "Grupo Rincón",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "Organization",
    name: "Faktu",
    url: companyUrl,
  },
  contentLocation: { "@type": "Country", name: "Chile" },
  keywords: ["software de cobranza", "gestión de facturas", "pasarela de pago", "AWS"],
};

const capabilities = [
  {
    number: "01",
    title: "Contratación y pago en línea",
    description:
      "El cliente puede registrarse, elegir un servicio y completar su contratación mediante un flujo con pasarela de pago.",
  },
  {
    number: "02",
    title: "Control de la cobranza",
    description:
      "Las facturas, sus estados y las gestiones quedan reunidas en una plataforma para el equipo y los clientes.",
  },
  {
    number: "03",
    title: "Gestión automática",
    description:
      "Reglas de correo y tareas programadas apoyan el seguimiento, los resúmenes financieros y la facturación recurrente.",
  },
  {
    number: "04",
    title: "Infraestructura en AWS",
    description:
      "La solución utiliza servicios de AWS para almacenar archivos y respaldar procesos del sistema.",
  },
];

const faqItems = [
  {
    question: "¿Qué resuelve la plataforma de Faktu?",
    answer:
      "Reúne la contratación de servicios, el pago, las facturas y el seguimiento de cobranza en un mismo sistema.",
  },
  {
    question: "¿Qué procesos se automatizaron?",
    answer:
      "El sistema ejecuta reglas de correo, actualizaciones de cartera, resúmenes financieros y tareas de facturación programadas.",
  },
  {
    question: "¿Cuánto tiempo lleva evolucionando el producto?",
    answer:
      "Faktu suma cuatro años de desarrollo continuo. Durante ese tiempo se han ampliado sus funciones y su infraestructura.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title="Faktu: plataforma de gestión de cobranza | Grupo Rincón"
  description="Caso de Faktu en Chile: contratación y pagos en línea, control de cobranza y gestión automática en un sistema que lleva cuatro años de desarrollo continuo."
  socialImage="/casos/faktu/logo-color.png"
  socialImageAlt="Logo de Faktu, plataforma de gestión de cobranza"
  socialImageWidth={3937}
  socialImageHeight={1116}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    { name: "Casos de éxito", url: new URL("/casos-de-exito/", canonicalBase).toString() },
    { name: "Faktu", url: pageUrl },
  ]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(caseSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44">
    <div class="pointer-events-none absolute left-1/2 top-0 h-[560px] w-[820px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px]" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500">
          <li><a href="/" class="transition-colors hover:text-white">Inicio</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li><a href="/casos-de-exito/" class="transition-colors hover:text-white">Casos de éxito</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">Faktu</li>
        </ol>
      </nav>

      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300">Caso de éxito</span>
            <span class="font-display text-xs font-semibold text-zinc-500">Chile · Cobranza · Software a medida</span>
          </div>
          <h1 class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Faktu: una plataforma para
            <span class="text-secondary-300"> gestionar la cobranza de principio a fin.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
            Desarrollamos el sistema con el que los clientes de Faktu contratan servicios y pagan en línea. El equipo controla las facturas y organiza las gestiones de cobranza. El producto lleva cuatro años en evolución continua.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={appUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-colors duration-200 hover:border-secondary-500/40 hover:bg-secondary-500/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400">
              Visitar la plataforma <span aria-hidden="true">↗</span>
            </a>
            <a href={companyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-bold text-zinc-300 transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400">
              Conocer Faktu <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="reveal"><FaktuCaseVisual /></div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">El reto</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Dar seguimiento a cada factura sin perder el contexto.</h2>
      </div>
      <div class="reveal space-y-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
        <p>Faktu se especializa en recuperar facturas impagas de organismos públicos en Chile. Sus clientes necesitan conocer el estado de sus documentos. El equipo necesita coordinar acciones, responsables y próximos pasos.</p>
        <p>La plataforma debía conectar el ingreso de clientes y la contratación con el trabajo diario de cobranza. También debía crecer a medida que se incorporaban nuevos servicios y formas de gestión.</p>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Lo que construimos</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Del alta del cliente al control de la cartera.</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">El sistema reúne los pasos comerciales y operativos que Faktu usa para prestar su servicio.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {capabilities.map((item, index) => (
          <article class="reveal rounded-3xl border border-white/[0.07] bg-zinc-900/45 p-7 sm:p-8" style={`animation-delay: ${index * 70}ms`}>
            <span class="font-display text-xs font-bold tracking-widest text-secondary-400">{item.number}</span>
            <h3 class="mt-6 font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{item.title}</h3>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400 sm:text-base">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Cuatro años de evolución</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Un producto que sigue creciendo con la operación.</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">Faktu no se quedó en una primera versión. Durante cuatro años de desarrollo continuo, el sistema incorporó nuevas funciones para la contratación, la cobranza y el control financiero.</p>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">La automatización ayuda a ejecutar tareas repetitivas. El equipo conserva el control de los casos que requieren criterio y gestión especializada.</p>
      </div>
      <div class="reveal rounded-3xl border border-white/[0.07] bg-black/35 p-7 sm:p-9">
        <span class="font-display text-6xl font-black tracking-tight text-white sm:text-7xl">4</span>
        <span class="ml-2 font-display text-xl font-bold text-secondary-300">años</span>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-zinc-400">de desarrollo continuo y ampliación del sistema de gestión.</p>
        <div class="mt-8 grid gap-3 border-t border-white/10 pt-6 sm:grid-cols-2">
          <span class="rounded-xl border border-white/[0.07] bg-zinc-900/60 px-4 py-3 text-sm text-zinc-300">Cobranza y seguimiento</span>
          <span class="rounded-xl border border-white/[0.07] bg-zinc-900/60 px-4 py-3 text-sm text-zinc-300">Contratación y pagos</span>
          <span class="rounded-xl border border-white/[0.07] bg-zinc-900/60 px-4 py-3 text-sm text-zinc-300">Reglas y procesos automáticos</span>
          <span class="rounded-xl border border-white/[0.07] bg-zinc-900/60 px-4 py-3 text-sm text-zinc-300">Infraestructura AWS</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Preguntas frecuentes</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Lo esencial del sistema Faktu.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map((item, index) => (
          <article class="reveal rounded-2xl border border-white/[0.07] bg-zinc-900/45 p-6 sm:p-7" style={`animation-delay: ${index * 70}ms`}>
            <h3 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{item.question}</h3>
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-zinc-400">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal">
      <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Tu operación puede ser la próxima</span>
      <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">Convirtamos tu proceso en un sistema que pueda crecer.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">Cuéntanos qué necesita controlar tu empresa. Podemos definir la primera versión y seguir mejorándola contigo.</p>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="glow-btn mt-8 inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-colors duration-200 hover:bg-secondary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-300">
        Hablemos de tu proyecto <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
