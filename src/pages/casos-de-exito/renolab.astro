---
import { waLink } from "../../config/markets";
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL("/casos-de-exito/renolab/", canonicalBase).toString();
const siteUrl = "https://renolab.cl/";

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline:
    "RENOLAB: sitio WordPress y PWA para gestionar servicios de clientes",
  description:
    "Caso de éxito sobre el ecosistema digital de RENOLAB en Chile: un sitio corporativo en WordPress y una PWA en Vue para la administración de servicios de clientes.",
  mainEntityOfPage: pageUrl,
  author: {
    "@type": "Organization",
    name: "Grupo Rincon",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "Organization",
    name: "RENOLAB",
    url: siteUrl,
  },
  contentLocation: {
    "@type": "Country",
    name: "Chile",
  },
  keywords: ["WordPress", "PWA", "Vue", "Supabase", "Vercel"],
};

const stack = [
  ["Sitio institucional", "WordPress"],
  ["Aplicación operativa", "Vue.js + PWA"],
  ["Datos y autenticación", "Supabase"],
  ["Despliegue", "Vercel"],
];

const solutionPoints = [
  "Una web en WordPress para explicar los servicios y facilitar el contacto.",
  "Una PWA en Vue para gestionar los servicios de clientes.",
  "Supabase para los datos y el acceso a la aplicación.",
  "Vercel para publicar y actualizar la aplicación web.",
];

const faqItems = [
  {
    question: "¿Qué incluye el proyecto digital de RENOLAB?",
    answer:
      "Incluye un sitio corporativo en WordPress y una PWA en Vue para gestionar los servicios de clientes.",
  },
  {
    question: "¿Para qué sirve la PWA de RENOLAB?",
    answer:
      "La PWA permite consultar vehículos, atenciones, correcciones y reportes desde una aplicación web.",
  },
  {
    question: "¿Qué tecnologías utiliza RENOLAB?",
    answer:
      "El sitio usa WordPress. La PWA usa Vue, Supabase para datos y autenticación, y Vercel para el despliegue.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout
  title="RENOLAB: sitio WordPress y PWA para servicios | Grupo Rincon"
  description="Conoce el caso de RENOLAB en Chile: una one page en WordPress y una PWA en Vue con Supabase para la administración de servicios de clientes."
  socialImage="/casos/renolab/dashboard-trazabilidad.png"
  socialImageAlt="Dashboard de trazabilidad de RENOLAB"
  socialImageWidth={1577}
  socialImageHeight={837}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    {
      name: "Casos de éxito",
      url: new URL("/casos-de-exito/", canonicalBase).toString(),
    },
    { name: "RENOLAB", url: pageUrl },
  ]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(caseSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44">
    <div class="pointer-events-none absolute left-1/2 top-0 h-[560px] w-[820px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] bg-size-[30px_30px] opacity-25" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500">
          <li><a href="/" class="transition-colors hover:text-white">Inicio</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li><a href="/casos-de-exito/" class="transition-colors hover:text-white">Casos de éxito</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">RENOLAB</li>
        </ol>
      </nav>

      <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300">Caso de éxito</span>
            <span class="font-display text-xs font-semibold text-zinc-500">Chile · Servicios técnicos · Web + PWA</span>
          </div>
          <h1 class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Presencia digital y gestión operativa
            <span class="bg-linear-to-r from-blue-400 via-secondary-300 to-indigo-400 bg-clip-text text-transparent"> en un mismo ecosistema.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
            Para RENOLAB desarrollamos una web corporativa enfocada en comunicar sus servicios y una PWA para apoyar la administración de los servicios de sus clientes.
          </p>
          <a href={siteUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-colors duration-200 hover:border-secondary-500/40 hover:bg-secondary-500/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400">
            Visitar RENOLAB
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5h5m0 0v5m0-5L10 14M19 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h4" /></svg>
          </a>
        </div>

        <div class="reveal overflow-hidden rounded-3xl border border-white/10 bg-zinc-950 shadow-2xl shadow-black/30">
          <img
            src="/casos/renolab/pwa-macbook.png"
            width="1536"
            height="1024"
            alt="Dashboard de RENOLAB en una computadora portátil"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:px-8">
      <div class="reveal overflow-hidden rounded-3xl border border-white/[0.07] bg-zinc-900/45">
        <img
          src="/casos/renolab/sitio-renolab.png"
          width="1920"
          height="5748"
          alt="Sitio corporativo de RENOLAB para servicios de detailing de flotas"
          class="h-[500px] w-full object-cover object-top sm:h-[620px]"
          loading="lazy"
        />
      </div>
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Sitio corporativo</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Una web para explicar el servicio con claridad.</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-400 sm:text-lg">La one page organiza la propuesta de valor de RENOLAB, sus soluciones para flotas y el proceso de contacto en una experiencia enfocada en empresas.</p>
        <a href={siteUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-secondary-300 transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400">
          Ver sitio publicado
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5h5m0 0v5m0-5L10 14M19 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h4" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">El reto</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Comunicar el servicio y ordenar la operación sin mezclar ambas experiencias.</h2>
      </div>
      <div class="reveal space-y-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
        <p>RENOLAB necesitaba una presencia digital clara para describir sus servicios en Chile y facilitar el primer contacto comercial.</p>
        <p>RENOLAB también necesitaba una herramienta para gestionar los servicios de sus clientes.</p>
        <p>Esta herramienta debía estar separada del sitio público. Así, cada usuario encuentra una experiencia pensada para su necesidad.</p>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-3xl text-center reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">La arquitectura</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Dos experiencias, una operación más conectada.</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {stack.map(([label, value], index) => (
          <article class="reveal rounded-3xl border border-white/[0.07] bg-zinc-900/45 p-7 sm:p-8" style={`animation-delay: ${index * 70}ms`}>
            <span class="font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-400">{label}</span>
            <p class="mt-5 font-display text-xl font-bold tracking-tight text-white">{value}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-white/[0.07] reveal">
        <table class="min-w-full border-collapse text-left text-sm">
          <caption class="sr-only">Tecnologías utilizadas en el proyecto RENOLAB</caption>
          <thead class="border-b border-white/[0.07] bg-white/[0.03] text-[10px] font-bold uppercase tracking-[0.16em] text-zinc-500">
            <tr>
              <th scope="col" class="px-5 py-4 sm:px-6">Área</th>
              <th scope="col" class="px-5 py-4 sm:px-6">Tecnología</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.06] text-zinc-300">
            {stack.map(([label, value]) => (
              <tr>
                <th scope="row" class="whitespace-nowrap px-5 py-4 font-semibold text-white sm:px-6">{label}</th>
                <td class="px-5 py-4 sm:px-6">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-zinc-950 py-20 lg:py-28">
    <div class="pointer-events-none absolute right-0 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-secondary-600/5 blur-[120px]" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">La solución</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Una plataforma pública para explicar. Una PWA para gestionar.</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">El sitio público explica los servicios y facilita el contacto. La PWA ayuda al equipo a gestionar la operación diaria. Ambas soluciones pueden crecer sin mezclarse.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {solutionPoints.map((point, index) => (
          <div class="reveal flex gap-4 rounded-2xl border border-white/[0.07] bg-black/35 p-6" style={`animation-delay: ${index * 70}ms`}>
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary-500/15 text-secondary-300"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg></span>
            <p class="text-sm leading-relaxed text-zinc-300">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-black py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20 lg:px-8">
      <div class="reveal overflow-hidden rounded-3xl border border-white/[0.07] bg-zinc-900/45">
        <img
          src="/casos/renolab/dashboard-trazabilidad.png"
          width="1577"
          height="837"
          alt="Dashboard de trazabilidad de RENOLAB con gestión de vehículos y atenciones"
          class="h-auto w-full"
          loading="lazy"
        />
      </div>
      <div class="reveal flex items-center gap-6 sm:gap-8">
        <div class="min-w-0 flex-1">
          <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">PWA operativa</span>
          <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">La información de operación, disponible cuando se necesita.</h2>
          <p class="mt-5 text-base leading-relaxed text-zinc-400">La aplicación reúne vehículos, atenciones, correcciones y reportes. Así, el equipo puede seguir cada servicio con más claridad.</p>
        </div>
        <img
          src="/casos/renolab/pwa-movil.png"
          width="510"
          height="921"
          alt="Vista móvil de la PWA de RENOLAB"
          class="w-28 shrink-0 sm:w-32 lg:w-36"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Preguntas frecuentes</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Lo esencial del proyecto RENOLAB.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map((item, index) => (
          <article class="reveal rounded-2xl border border-white/[0.07] bg-black/35 p-6 sm:p-7" style={`animation-delay: ${index * 70}ms`}>
            <h2 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{item.question}</h2>
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-zinc-400">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-white/[0.06] bg-black py-20 lg:py-28">
    <div class="pointer-events-none absolute bottom-0 left-1/2 h-80 w-[680px] -translate-x-1/2 rounded-full bg-secondary-500/10 blur-[130px]" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal">
      <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Tu proyecto puede ser el próximo</span>
      <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">Construyamos una experiencia digital que también ayude a operar.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">Cuéntanos qué necesitas resolver. Definimos una primera solución útil para tu empresa.</p>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="glow-btn mt-8 inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-colors duration-200 hover:bg-secondary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-300">
        Hablemos de tu proyecto
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </section>
</Layout>
