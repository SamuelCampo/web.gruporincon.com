---
import { waLink } from "../../config/markets";
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL("/casos-de-exito/aliat/", canonicalBase).toString();
const siteUrl = "https://aliatesp.com/";
const imageUrl = new URL("/casos/aliat/equipo.webp", canonicalBase).toString();

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Aliat: de Next.js a WordPress autoadministrable con Elementor",
  description:
    "Caso de éxito de Aliat: migración de Next.js a WordPress y Elementor para que su equipo administre el sitio sin perder una experiencia de carga ágil.",
  image: imageUrl,
  mainEntityOfPage: pageUrl,
  author: {
    "@type": "Organization",
    name: "Grupo Rincón",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "Organization",
    name: "Aliat Servicios S.A.S. E.S.P.",
    url: siteUrl,
  },
  contentLocation: { "@type": "Place", name: "Cartagena, Colombia" },
  keywords: ["WordPress", "Elementor", "migración de Next.js", "sitio autoadministrable"],
};

const changes = [
  { area: "Plataforma", before: "Sitio en Next.js", after: "Sitio en WordPress y Elementor" },
  { area: "Edición", before: "Cambios ligados al desarrollo", after: "Contenido administrable por el equipo" },
  { area: "Experiencia", before: "Carga rápida", after: "Carga ágil con mayor autonomía" },
];

const faqItems = [
  {
    question: "¿Qué cambió al migrar el sitio de Aliat a WordPress?",
    answer:
      "El equipo de Aliat ahora puede actualizar páginas y contenidos desde WordPress y Elementor, sin depender de cambios en el código para las tareas habituales.",
  },
  {
    question: "¿Por qué se usó Elementor?",
    answer:
      "Elementor permite editar secciones visuales del sitio. Así, Aliat puede mantener sus servicios, noticias y mensajes al día desde una interfaz de administración.",
  },
  {
    question: "¿Se sacrificó la velocidad de carga?",
    answer:
      "La migración se planteó para conservar la experiencia de carga ágil del sitio anterior. No publicamos una cifra comparativa porque no contamos con una medición verificable de ambas versiones.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title="Aliat: de Next.js a WordPress administrable | Grupo Rincón"
  description="Migramos el sitio de Aliat de Next.js a WordPress y Elementor. Ahora su equipo puede administrar el contenido y mantener una experiencia de carga ágil."
  socialImage="/casos/aliat/equipo.webp"
  socialImageAlt="Integrante del equipo de Aliat frente a sus instalaciones"
  socialImageWidth={1200}
  socialImageHeight={801}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    { name: "Casos de éxito", url: new URL("/casos-de-exito/", canonicalBase).toString() },
    { name: "Aliat", url: pageUrl },
  ]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(caseSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <section class="relative isolate overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44">
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500">
          <li><a href="/" class="transition-colors hover:text-white">Inicio</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li><a href="/casos-de-exito/" class="transition-colors hover:text-white">Casos de éxito</a></li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">Aliat</li>
        </ol>
      </nav>

      <div class="grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300">Caso de éxito</span>
            <span class="font-display text-xs font-semibold text-zinc-500">Cartagena, Colombia · Servicios públicos</span>
          </div>
          <h1 class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
            De Next.js a WordPress:
            <span class="text-secondary-300"> una web rápida que Aliat puede administrar.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
            Transformamos el sitio de Aliat en una web autoadministrable con WordPress y Elementor. Su equipo puede actualizar el contenido sin depender del código, mientras conserva una experiencia de carga ágil.
          </p>
          <a href={siteUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-colors duration-200 hover:border-secondary-500/40 hover:bg-secondary-500/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400">
            Visitar sitio web <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="reveal overflow-hidden rounded-3xl border border-white/10 bg-[#143e42]">
          <div class="flex items-center justify-between gap-4 border-b border-white/10 bg-[#f5f7f4] px-5 py-4 sm:px-6">
            <img src="/casos/aliat/logo.png" width="300" height="67" alt="Aliat, para todos, todo" class="h-8 w-auto sm:h-10" loading="eager" />
            <span class="rounded-full border border-[#295e64]/20 px-3 py-1 font-display text-[10px] font-bold uppercase tracking-widest text-[#295e64]">aliatesp.com</span>
          </div>
          <img src="/casos/aliat/equipo.webp" width="1200" height="801" alt="Integrante del equipo de Aliat frente a sus instalaciones" class="aspect-[16/10] w-full object-cover" loading="eager" fetchpriority="high" />
          <div class="grid grid-cols-2 gap-3 p-4 text-xs font-semibold text-white sm:p-5">
            <span class="rounded-xl border border-white/15 px-3 py-2 text-center">WordPress + Elementor</span>
            <span class="rounded-xl border border-white/15 px-3 py-2 text-center">Contenido administrable</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">El reto</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">¿Cómo dar autonomía al equipo sin perder agilidad?</h2>
      </div>
      <div class="reveal space-y-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
        <p>Aliat atiende a comunidades de Serena del Mar, en Cartagena, con servicios como internet, alcantarillado, aseo y riego. Su sitio reúne información de servicios, noticias, preguntas frecuentes y canales de atención.</p>
        <p>La versión anterior estaba hecha en Next.js. Para el equipo, actualizar el contenido cotidiano requería apoyo técnico. El nuevo sitio debía facilitar esos cambios sin renunciar a la rapidez que ya ofrecía la web.</p>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-3xl reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">La transformación</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">La misma facilidad para navegar. Más libertad para publicar.</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">Migramos la experiencia a WordPress y construimos sus secciones con Elementor. El cambio pone la administración de la web en manos del equipo.</p>
      </div>
      <div class="reveal overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/45">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <caption class="sr-only">Comparación del sitio Aliat antes y después de la migración</caption>
          <thead class="bg-zinc-900 text-xs uppercase tracking-wider text-zinc-300">
            <tr><th scope="col" class="px-4 py-4 sm:px-7">Área</th><th scope="col" class="px-4 py-4 sm:px-7">Antes</th><th scope="col" class="px-4 py-4 sm:px-7">Ahora</th></tr>
          </thead>
          <tbody>
            {changes.map((item) => (
              <tr class="border-t border-white/[0.07]"><th scope="row" class="px-4 py-5 font-semibold text-white sm:px-7">{item.area}</th><td class="px-4 py-5 text-zinc-400 sm:px-7">{item.before}</td><td class="px-4 py-5 text-secondary-300 sm:px-7">{item.after}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:px-8">
      <div class="reveal overflow-hidden rounded-3xl border border-white/10">
        <img src="/casos/aliat/familia.webp" width="1000" height="668" alt="Familia consultando información en línea, imagen del sitio de Aliat" class="aspect-[4/3] w-full object-cover" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">El resultado</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">¿Qué ganó Aliat con el cambio?</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">Un sitio que su equipo puede mantener al día. Ahora es más sencillo editar páginas, presentar servicios y publicar novedades desde WordPress y Elementor.</p>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">La migración conservó el foco en una carga ágil. Así, la autonomía editorial no obliga a volver a un sitio lento ni a pedir desarrollo para cada ajuste de contenido.</p>
        <ul class="mt-7 space-y-3 text-sm text-zinc-300 sm:text-base">
          <li class="flex gap-3"><span class="text-secondary-400" aria-hidden="true">✓</span>Edición de contenido por el equipo de Aliat</li>
          <li class="flex gap-3"><span class="text-secondary-400" aria-hidden="true">✓</span>Secciones visuales construidas con Elementor</li>
          <li class="flex gap-3"><span class="text-secondary-400" aria-hidden="true">✓</span>Experiencia de carga ágil para los visitantes</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Preguntas frecuentes</span>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Lo esencial de la migración de Aliat.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map((item) => (
          <article class="reveal rounded-2xl border border-white/[0.07] bg-zinc-900/45 p-6 sm:p-7">
            <h3 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{item.question}</h3>
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-zinc-400">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal">
      <span class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400">Tu sitio también puede evolucionar</span>
      <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">Haz que tu equipo pueda actualizar la web.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">Si tu empresa depende de un desarrollador para cada cambio, conversemos sobre una web fácil de administrar y preparada para crecer.</p>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="glow-btn mt-8 inline-flex items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-colors duration-200 hover:bg-secondary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-300">
        Hablemos de tu proyecto <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
