---
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL(
  "/casos-de-exito/housiders-housereel/",
  canonicalBase,
).toString();
const imageUrl = new URL("/portfolio/Housiders.avif", canonicalBase).toString();

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline:
    "Housiders y HouseReel: automatización audiovisual para el sector inmobiliario",
  description:
    "Caso de éxito sobre una app que transforma fotos y videos de propiedades en contenido profesional y automatiza su publicación en un portal inmobiliario.",
  image: imageUrl,
  mainEntityOfPage: pageUrl,
  author: {
    "@type": "Organization",
    name: "Grupo Rincon",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "SoftwareApplication",
    name: "Housiders",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "iOS",
    url: "https://apps.apple.com/es/app/housiders/id6446966206",
  },
  contentLocation: { "@type": "Country", name: "España" },
};

const flow = [
  {
    number: "01",
    title: "Capturar",
    description:
      "El profesional carga fotos, graba estancias o construye un house tour desde el móvil.",
  },
  {
    number: "02",
    title: "Producir",
    description:
      "La plataforma procesa los archivos y aplica patrones de edición asistidos por inteligencia artificial.",
  },
  {
    number: "03",
    title: "Distribuir",
    description:
      "Entrega video y piezas adaptadas para redes, portales inmobiliarios y la publicación en HouseReel.",
  },
];

const problems = [
  "Dependencia de editores o proveedores externos para producir cada video.",
  "Tiempos largos entre la captación de una propiedad y su promoción digital.",
  "Contenido inconsistente al publicar una misma propiedad en varios canales.",
  "Fotos estáticas que no transmiten el recorrido, escala y ambiente del inmueble.",
];

const stack = [
  {
    name: "AWS Lambda",
    copy: "Orquestación serverless de tareas y procesos activados bajo demanda.",
  },
  {
    name: "AWS Elemental MediaConvert",
    copy: "Procesamiento, normalización y generación automatizada de piezas de video.",
  },
  {
    name: "Amazon S3",
    copy: "Almacenamiento escalable para fotografías, videos, derivados y activos publicados.",
  },
  {
    name: "Amazon Route 53",
    copy: "Resolución DNS y disponibilidad de los servicios y dominios de la plataforma.",
  },
  {
    name: "Inteligencia artificial",
    copy: "Mejora de patrones de edición y automatización de decisiones audiovisuales repetitivas.",
  },
  {
    name: "App iOS + portal",
    copy: "Experiencia conectada entre la captura móvil, la producción y la exhibición de propiedades.",
  },
];
---

<Layout
  title="Housiders: app inmobiliaria con IA y AWS | Grupo Rincon"
  description="Conoce cómo construimos para España una app y un portal inmobiliario que automatizan videos y publicaciones de propiedades con IA."
  socialImage="/portfolio/Housiders.avif"
  socialImageAlt="HouseReel, portal inmobiliario conectado a la app Housiders"
  socialImageWidth={1920}
  socialImageHeight={600}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    {
      name: "Casos de éxito",
      url: new URL("/casos-de-exito/", canonicalBase).toString(),
    },
    { name: "Housiders", url: pageUrl },
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(caseSchema)}
  />

  <section
    class="relative overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44"
  >
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[560px] w-[820px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] bg-size-[30px_30px] opacity-25"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol
          class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500"
        >
          <li>
            <a href="/" class="transition-colors hover:text-white">Inicio</a>
          </li><li aria-hidden="true" class="text-zinc-700">/</li>
          <li>
            <a
              href="/casos-de-exito/"
              class="transition-colors hover:text-white">Casos de éxito</a
            >
          </li><li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">
            Housiders + HouseReel
          </li>
        </ol>
      </nav>
      <div
        class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16"
      >
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span
              class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300"
              >Caso de éxito</span
            >
            <span class="font-display text-xs font-semibold text-zinc-500"
              >España · PropTech · App móvil + IA + AWS</span
            >
          </div>
          <h1
            class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            De fotos de una propiedad a una experiencia de venta
            <span
              class="bg-linear-to-r from-blue-400 via-secondary-300 to-indigo-400 bg-clip-text text-transparent"
            >
              lista para publicar.</span
            >
          </h1>
          <p
            class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg"
          >
            Creamos Housiders para simplificar la promoción de propiedades. El
            agente captura fotos y videos desde su teléfono. La plataforma edita
            el contenido y publica el inmueble en HouseReel.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              ["iOS", "AWS", "Serverless", "Video", "IA"].map((item) => (
                <span class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-semibold text-zinc-300">
                  {item}
                </span>
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="https://housereel.es"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-secondary-500 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-secondary-600"
              >Visitar HouseReel ↗</a
            >
            <a
              href="https://apps.apple.com/es/app/housiders/id6446966206"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-colors hover:border-secondary-500/40"
              >Ver app iOS ↗</a
            >
          </div>
        </div>
        <div class="reveal">
          <div
            class="relative overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl shadow-secondary-950/40"
          >
            <img
              src="/casos/housiders/portal-hero.jpg"
              width="1920"
              height="600"
              alt="Portal inmobiliario HouseReel con propiedades en la costa española"
              class="aspect-[16/10] h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/75 via-transparent to-transparent"
            >
            </div>
            <img
              src="/casos/housiders/housereel-logo.png"
              width="1930"
              height="463"
              alt="HouseReel"
              class="absolute bottom-7 left-7 h-auto w-48 brightness-0 invert sm:w-64"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >El reto</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Convertir producción audiovisual especializada en un flujo cotidiano.
        </h2>
      </div>
      <div class="reveal">
        <p class="text-base leading-relaxed text-zinc-400 sm:text-lg">
          Crear el video de una vivienda exigía varios pasos. Había que grabar,
          editar, exportar y publicar el contenido.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
          Repetir este trabajo para cada inmueble consumía tiempo. También hacía
          más difícil mantener la misma calidad en todas las publicaciones.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
          Reunimos todo el proceso en una sola app. Detrás de ella, AWS procesa
          los archivos y genera los formatos para cada canal.
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            problems.map((problem) => (
              <div class="rounded-2xl border border-white/[0.07] bg-black/30 p-5 text-sm leading-relaxed text-zinc-300">
                {problem}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-3xl text-center reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >El flujo automatizado</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una sola operación, desde el móvil hasta el comprador.
        </h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {
          flow.map((item, index) => (
            <article
              class="reveal rounded-3xl border border-white/[0.07] bg-zinc-900/45 p-7 sm:p-8"
              style={`animation-delay: ${index * 80}ms`}
            >
              <>
                <span class="font-display text-xs font-black tracking-widest text-secondary-400">
                  {item.number}
                </span>
                <h3 class="mt-6 font-display text-xl font-black text-white">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">
                  {item.description}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-zinc-950 py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >La herramienta</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una app creada para el trabajo real de una inmobiliaria.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Housiders permite organizar propiedades y capturar fotos o videos. La
          app convierte ese material en contenido profesional.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Cada pieza queda lista para Instagram, YouTube, LinkedIn, TikTok y
          portales inmobiliarios.
        </p>
        <p class="mt-5 text-sm leading-relaxed text-zinc-500">
          La app también incluye animación de imágenes y home staging con IA. El
          agente puede ordenar las estancias, elegir música y crear el recorrido
          de la vivienda por partes.
        </p>
      </div>
      <div
        class="reveal flex items-end justify-center gap-3 overflow-hidden rounded-3xl border border-white/[0.07] bg-black/40 px-5 pt-8 sm:gap-5 sm:px-8"
      >
        {
          [
            [
              "/casos/housiders/app-captura-1.webp",
              "Pantalla de Housiders para crear contenido inmobiliario",
            ],
            [
              "/casos/housiders/app-captura-2.webp",
              "Gestión de propiedades en la app Housiders",
            ],
            [
              "/casos/housiders/app-captura-3.webp",
              "Carga de fotografías y videos en Housiders",
            ],
            [
              "/casos/housiders/app-captura-4.webp",
              "Edición de contenido inmobiliario en Housiders",
            ],
          ].map(([src, alt], index) => (
            <img
              src={src}
              width="156"
              height="340"
              alt={alt}
              loading="lazy"
              class:list={[
                "w-[23%] rounded-t-2xl border border-white/10 shadow-2xl",
                index === 0 || index === 3 ? "translate-y-8 opacity-70" : "",
              ]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >Arquitectura de la solución</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una infraestructura de video que crece según la demanda.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Construimos la plataforma sobre AWS. Cada servicio cumple una tarea y
          se activa cuando hace falta. Así, el sistema procesa más propiedades
          sin mantener servidores activos.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          stack.map((item, index) => (
            <article
              class="reveal rounded-2xl border border-white/[0.07] bg-zinc-900/45 p-6"
              style={`animation-delay: ${index * 60}ms`}
            >
              <>
                <h3 class="font-display text-lg font-black text-white">
                  {item.name}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">
                  {item.copy}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8"
    >
      <div class="reveal overflow-hidden rounded-3xl border border-white/10">
        <img
          src="/casos/housiders/agente-grabando.jpg"
          width="1440"
          height="2560"
          alt="Profesional inmobiliario grabando una propiedad con el móvil"
          loading="lazy"
          class="aspect-[4/3] w-full object-cover object-center"
        />
      </div>
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >De España a Venezuela</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una solución creada en España que también puede impulsar el mercado
          venezolano.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          El producto fue creado para España. Hoy muestra propiedades de la
          Costa del Sol y la Costa Blanca.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          El proyecto demuestra que una inmobiliaria puede centralizar su
          contenido. También puede publicar su inventario con mayor rapidez y
          mantener una imagen consistente.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          El mismo modelo puede aplicarse en Venezuela. Agencias, promotoras y
          franquicias pueden reducir el tiempo de publicación y presentar mejor
          cada inmueble.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          Los videos también ayudan a compradores que están fuera del país.
          Pueden conocer mejor la propiedad antes de solicitar una visita.
        </p>
        <div
          class="mt-7 rounded-2xl border border-secondary-500/20 bg-secondary-500/10 p-6"
        >
          <p class="font-display text-sm font-bold text-secondary-200">
            La oportunidad para Venezuela
          </p>
          <p class="mt-2 text-sm leading-relaxed text-zinc-300">
            Convertir el teléfono del asesor en una herramienta para capturar,
            crear y publicar contenido inmobiliario.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="relative overflow-hidden border-t border-white/[0.06] bg-black py-20 lg:py-28"
  >
    <div
      class="pointer-events-none absolute bottom-0 left-1/2 h-80 w-[680px] -translate-x-1/2 rounded-full bg-secondary-500/10 blur-[130px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal"
    >
      <span
        class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
        >Tecnología para el sector inmobiliario</span
      >
      <h2
        class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        ¿Quieres automatizar cómo tu inmobiliaria crea y publica contenido?
      </h2>
      <p
        class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base"
      >
        Podemos diseñar una app, integrar inteligencia artificial y construir la
        infraestructura que conecte tu inventario con tus canales de venta.
      </p>
      <a
        href="https://wa.me/584262590251"
        target="_blank"
        rel="noopener noreferrer"
        class="glow-btn mt-8 inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-all duration-300 hover:bg-secondary-600"
        >Hablemos de tu proyecto <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Layout>
