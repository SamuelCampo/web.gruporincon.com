---
import Layout from "../../layouts/Layout.astro";

const canonicalBase = Astro.site || Astro.url;
const pageUrl = new URL("/casos-de-exito/mexicarga/", canonicalBase).toString();
const imageUrl = new URL("/portfolio/mexicarga.avif", canonicalBase).toString();

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline:
    "Mexicarga: de un HTML estático a un sitio WordPress orientado a cotizaciones",
  description:
    "Caso de éxito sobre la reestructuración del sitio de Mexicarga para facilitar la administración de contenidos y orientar las visitas hacia la cotización.",
  image: imageUrl,
  mainEntityOfPage: pageUrl,
  author: {
    "@type": "Organization",
    name: "Grupo Rincon",
    url: new URL("/", canonicalBase).toString(),
  },
  about: {
    "@type": "Organization",
    name: "Mexicarga",
    url: "https://mexicarga.com",
  },
  contentLocation: {
    "@type": "Country",
    name: "México",
  },
};

const transformations = [
  {
    label: "Tecnología",
    before: "HTML estático",
    after: "WordPress administrable",
  },
  {
    label: "Contenido",
    before: "Cambios dependientes de código",
    after: "Edición sencilla para el equipo",
  },
  {
    label: "Recorrido",
    before: "Información sin una ruta clara",
    after: "Navegación orientada a cotizar",
  },
];

const solutionPoints = [
  "Reestructuración de la arquitectura de información para presentar con claridad los servicios logísticos.",
  "Llamados a la acción visibles para acercar al visitante al proceso de cotización.",
  "Implementación en WordPress para facilitar la actualización del contenido sin editar código.",
  "Experiencia responsive preparada para consultas desde computadoras y dispositivos móviles.",
];
---

<Layout
  title="Mexicarga: rediseño web orientado a cotizaciones | Grupo Rincon"
  description="Conoce cómo transformamos el HTML estático de Mexicarga en un sitio WordPress administrable, con una estructura enfocada en convertir visitas en solicitudes de cotización."
  socialImage="/portfolio/mexicarga.avif"
  socialImageAlt="Rediseño del sitio web de Mexicarga por Grupo Rincon"
  socialImageWidth={3004}
  socialImageHeight={1408}
  breadcrumbs={[
    { name: "Inicio", url: new URL("/", canonicalBase).toString() },
    {
      name: "Casos de éxito",
      url: new URL("/casos-de-exito/", canonicalBase).toString(),
    },
    { name: "Mexicarga", url: pageUrl },
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(caseSchema)}
  />

  <section
    class="relative overflow-hidden bg-black pb-20 pt-36 sm:pt-40 lg:pb-28 lg:pt-44"
  >
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[560px] w-[820px] -translate-x-1/2 rounded-full bg-secondary-500/15 blur-[150px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] bg-size-[30px_30px] opacity-25"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-8 reveal">
        <ol
          class="flex flex-wrap items-center gap-2 text-xs font-semibold text-zinc-500"
        >
          <li>
            <a href="/" class="transition-colors hover:text-white">Inicio</a>
          </li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li>
            <a
              href="/casos-de-exito/"
              class="transition-colors hover:text-white">Casos de éxito</a>
          </li>
          <li aria-hidden="true" class="text-zinc-700">/</li>
          <li aria-current="page" class="text-zinc-300">Mexicarga</li>
        </ol>
      </nav>

      <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span
              class="rounded-full border border-secondary-500/25 bg-secondary-500/10 px-4 py-2 font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-300"
            >
              Caso de éxito
            </span>
            <span class="font-display text-xs font-semibold text-zinc-500"
              >México · Logística · Desarrollo web</span
            >
          </div>
          <h1
            class="font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            De un HTML estático a una web administrable
            <span
              class="bg-linear-to-r from-blue-400 via-secondary-300 to-indigo-400 bg-clip-text text-transparent"
            >
              enfocada en cotizaciones.
            </span>
          </h1>
          <p
            class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg"
          >
            Reestructuramos la presencia digital de Mexicarga para comunicar
            mejor sus servicios, facilitar la actualización del contenido y
            orientar cada visita hacia una solicitud de cotización.
          </p>
          <a
            href="https://mexicarga.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-6 py-3 text-sm font-bold text-white transition-all duration-300 hover:border-secondary-500/40 hover:bg-secondary-500/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-400"
          >
            Visitar sitio web
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.2"
                d="M14 5h5m0 0v5m0-5L10 14M19 14v4a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h4"
              ></path>
            </svg>
          </a>
        </div>

        <div class="reveal">
          <div
            class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl shadow-secondary-950/40"
          >
            <picture>
              <source srcset="/portfolio/mexicarga.avif" type="image/avif" />
              <source srcset="/portfolio/mexicarga.webp" type="image/webp" />
              <img
                src="/portfolio/mexicarga.webp"
                width="1000"
                height="625"
                alt="Nueva experiencia web administrable de Mexicarga"
                class="aspect-[16/10] h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-zinc-950 py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >El reto</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          La web debía dejar de ser solamente informativa.
        </h2>
      </div>
      <div class="reveal">
        <p class="text-base leading-relaxed text-zinc-400 sm:text-lg">
          El sitio anterior estaba construido en HTML estático. Actualizar
          textos, servicios o llamados a la acción requería intervenir
          directamente el código, lo que limitaba la autonomía del equipo y
          hacía más lenta la evolución del contenido.
        </p>
        <p class="mt-5 text-base leading-relaxed text-zinc-400 sm:text-lg">
          Además de modernizar la experiencia, el proyecto necesitaba
          reorganizar la información para que las visitas entendieran
          rápidamente la propuesta de Mexicarga y encontraran una ruta clara
          para solicitar una cotización.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-black py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-3xl text-center reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >La transformación</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          Una base más flexible para comunicar y convertir.
        </h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {
          transformations.map((item, index) => (
            <article
              class="reveal rounded-3xl border border-white/[0.07] bg-zinc-900/45 p-7 sm:p-8"
              style={`animation-delay: ${index * 80}ms`}
            >
              <span class="font-display text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-400">
                {item.label}
              </span>
              <div class="mt-6 border-l border-zinc-800 pl-5">
                <p class="text-sm text-zinc-600 line-through decoration-zinc-700">
                  {item.before}
                </p>
                <p class="mt-3 font-display text-lg font-bold text-white">
                  {item.after}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-zinc-950 py-20 lg:py-28">
    <div
      class="pointer-events-none absolute right-0 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-secondary-600/5 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative z-10 mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:px-8"
    >
      <div class="reveal">
        <span
          class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
          >La solución</span
        >
        <h2
          class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
        >
          WordPress como herramienta de gestión, no solo como tecnología.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-400">
          La nueva implementación permite que el sitio evolucione junto con la
          operación de Mexicarga y que su equipo pueda administrar información
          de forma más sencilla.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          solutionPoints.map((point, index) => (
            <div
              class="reveal flex gap-4 rounded-2xl border border-white/[0.07] bg-black/35 p-6"
              style={`animation-delay: ${index * 70}ms`}
            >
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary-500/15 text-secondary-300">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </span>
              <p class="text-sm leading-relaxed text-zinc-300">{point}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="relative overflow-hidden border-t border-white/[0.06] bg-black py-20 lg:py-28"
  >
    <div
      class="pointer-events-none absolute bottom-0 left-1/2 h-80 w-[680px] -translate-x-1/2 rounded-full bg-secondary-500/10 blur-[130px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 reveal"
    >
      <span
        class="font-display text-xs font-bold uppercase tracking-widest text-secondary-400"
        >¿Tu web también se quedó atrás?</span
      >
      <h2
        class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Convirtamos tu sitio en una herramienta comercial administrable.
      </h2>
      <p
        class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base"
      >
        Podemos ayudarte a reorganizar la experiencia, modernizar la tecnología
        y crear un recorrido más claro hacia la cotización.
      </p>
      <a
        href="https://wa.me/584262590251"
        target="_blank"
        rel="noopener noreferrer"
        class="glow-btn mt-8 inline-flex cursor-pointer items-center gap-2.5 rounded-full bg-secondary-500 px-8 py-4 font-display text-sm font-bold text-white transition-all duration-300 hover:bg-secondary-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-300"
      >
        Hablemos de tu proyecto
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>
