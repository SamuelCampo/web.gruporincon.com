---
import Layout from "../../layouts/Layout.astro";

const title = "Soporte y Mantenimiento WordPress | Grupo Rincón";
const description =
    "Planes de soporte y mantenimiento WordPress para mantener tu sitio seguro, actualizado y funcionando de forma óptima. Actualizaciones, backups, seguridad y soporte profesional.";

const plans = [
    {
        name: "Junior",
        eyebrow: "Mantenimiento esencial",
        description: "La base necesaria para mantener un sitio WordPress actualizado.",
        price: "70",
        suffix: "USD / mes",
        featured: false,
        custom: false,
        features: [
            "Actualización de plugins",
            "Actualización del tema del sitio",
            "WordPress en su última versión estable",
            "1 actualización mensual de texto, noticia o imágenes",
        ],
    },
    {
        name: "Medium",
        eyebrow: "Administración integral",
        description: "Soporte continuo, contenido y protección para sitios activos.",
        price: "100",
        suffix: "USD / mes",
        featured: true,
        custom: false,
        features: [
            "Actualizaciones y revisiones del sitio",
            "Actualización de plugins, temas y WordPress",
            "Análisis de seguridad con Wordfence",
            "Acompañamiento en la administración",
            "Hasta 4 publicaciones de blog al mes",
            "Backup completo una vez al mes",
        ],
    },
    {
        name: "Security",
        eyebrow: "Protección avanzada",
        description: "Seguridad reforzada y recuperación para sitios críticos.",
        price: "150",
        suffix: "USD / mes",
        featured: false,
        custom: false,
        features: [
            "Actualizaciones y revisiones del sitio",
            "Actualización de plugins, temas y WordPress",
            "Análisis de seguridad con Wordfence",
            "Limpieza de malware mediante SFTP o SSH",
            "Acompañamiento en la administración",
            "Hasta 6 publicaciones de blog al mes",
            "Respaldo quincenal del sitio web",
        ],
    },
    {
        name: "A la medida",
        eyebrow: "Necesidades especiales",
        description: "Un alcance diseñado alrededor de tu sitio, equipo y operación.",
        price: "Consultar",
        suffix: "Propuesta personalizada",
        featured: false,
        custom: true,
        features: [
            "Bolsa de horas de soporte",
            "Múltiples sitios o instalaciones WordPress",
            "Frecuencia de respaldos personalizada",
            "Monitoreo, rendimiento e integraciones",
            "Atención prioritaria según acuerdo",
            "Alcance y precio adaptados a tu operación",
        ],
    },
];

const benefits = [
    {
        title: "Seguridad continua",
        description: "Reducimos vulnerabilidades con actualizaciones, revisiones y análisis preventivos.",
        icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    },
    {
        title: "Rendimiento estable",
        description: "Mantenemos WordPress, temas y plugins compatibles para evitar fallas inesperadas.",
        icon: "M13 10V3L4 14h7v7l9-11h-7z",
    },
    {
        title: "Copias de respaldo",
        description: "Protegemos la información del sitio con respaldos programados según tu plan.",
        icon: "M4 7v10a2 2 0 002 2h12a2 2 0 002-2V7M9 11l3 3m0 0l3-3m-3 3V3",
    },
    {
        title: "Soporte profesional",
        description: "Tienes un equipo técnico disponible para ayudarte a administrar y cuidar tu web.",
        icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    },
];

const risks = [
    "Plugins desactualizados o de procedencia dudosa",
    "Temas antiguos o incompatibles",
    "Contraseñas débiles y accesos sin control",
    "Falta de respaldos antes de una actualización",
];

const faqs = [
    {
        question: "¿El mantenimiento incluye cambios en el contenido?",
        answer: "Sí. Cada plan indica la cantidad de actualizaciones o publicaciones incluidas. Si necesitas un volumen diferente, podemos prepararte un plan a la medida.",
    },
    {
        question: "¿Qué ocurre si mi sitio ya tiene malware?",
        answer: "El plan Security incluye análisis y limpieza de malware mediante acceso SFTP o SSH. Primero revisamos el estado del sitio para confirmar el alcance.",
    },
    {
        question: "¿Pueden encargarse de varios sitios WordPress?",
        answer: "Sí. El plan a la medida permite definir soporte para múltiples sitios, frecuencia de respaldos y niveles de atención según tu operación.",
    },
    {
        question: "¿Qué formas de pago aceptan?",
        answer: "Aceptamos efectivo, USDT y transferencias internacionales. Los pagos en bolívares se calculan con referencia a la tasa oficial vigente al momento del pago.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
};

const getWhatsAppURL = (plan: string) =>
    `https://wa.me/584262590251?text=${encodeURIComponent(`Hola, quiero información sobre el Plan ${plan} de soporte WordPress.`)}`;
---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <section class="relative min-h-screen flex items-center overflow-hidden bg-black">
        <div class="absolute inset-0 support-grid opacity-45" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/5 via-black/30 to-black" aria-hidden="true"></div>
        <div class="absolute -top-24 left-[8%] w-[36rem] h-[36rem] rounded-full bg-blue-600/10 blur-[150px]" aria-hidden="true"></div>
        <div class="absolute -bottom-20 right-[5%] w-[30rem] h-[30rem] rounded-full bg-violet-600/[0.08] blur-[140px]" aria-hidden="true"></div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 lg:pt-40 lg:pb-28">
            <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_.95fr] gap-14 lg:gap-20 items-center">
                <div class="reveal">
                    <div class="inline-flex items-center gap-2.5 rounded-full border border-blue-400/20 bg-blue-500/10 px-4 py-2 mb-8">
                        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span></span>
                        <span class="text-[10px] sm:text-xs font-bold text-blue-300 tracking-[0.18em] uppercase font-display">Tu WordPress siempre protegido</span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl lg:text-[4.25rem] font-black text-white leading-[1.02] tracking-tight font-display">
                        Soporte y mantenimiento<br class="hidden sm:block" />
                        <span class="bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-400 bg-clip-text text-transparent">WordPress</span>
                    </h1>
                    <p class="mt-7 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-2xl">Mantén tu sitio seguro, actualizado y funcionando de forma óptima. Nosotros cuidamos la parte técnica para que tú puedas concentrarte en tu negocio.</p>
                    <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                        <a href="#planes" class="glow-btn inline-flex justify-center items-center gap-2.5 bg-secondary-500 hover:bg-secondary-600 text-white px-7 py-4 rounded-full text-sm font-bold tracking-wide transition-all duration-300 shadow-lg shadow-blue-900/40">Ver planes de soporte <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg></a>
                        <a href={getWhatsAppURL("a la medida")} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 border border-white/15 hover:border-white/30 bg-white/[0.03] hover:bg-white/[0.07] text-zinc-200 px-7 py-4 rounded-full text-sm font-semibold transition-all duration-300">Consultar soporte a la medida</a>
                    </div>
                    <div class="mt-10 pt-7 border-t border-white/[0.07] flex flex-wrap gap-x-8 gap-y-4 text-xs text-zinc-500 font-display">
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Actualizaciones seguras</span>
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Respaldos programados</span>
                    </div>
                </div>

                <div class="hidden md:block reveal" style="animation-delay: 180ms;">
                    <div class="relative max-w-xl mx-auto">
                        <div class="absolute -inset-12 bg-blue-500/[0.08] blur-[90px] rounded-full"></div>
                        <div class="relative rounded-[2rem] border border-white/10 bg-zinc-950/85 backdrop-blur-xl shadow-2xl shadow-blue-950/30 overflow-hidden">
                            <div class="flex items-center justify-between px-5 py-4 border-b border-white/[0.07] bg-white/[0.02]">
                                <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span><span class="w-2.5 h-2.5 rounded-full bg-amber-400/70"></span><span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70"></span></div>
                                <span class="text-[10px] text-zinc-500 font-mono">estado_del_sitio</span>
                                <span class="text-[9px] font-bold text-emerald-300 bg-emerald-400/10 border border-emerald-400/15 px-2.5 py-1 rounded-full uppercase tracking-wider">Protegido</span>
                            </div>
                            <div class="p-7 sm:p-8">
                                <div class="flex items-center gap-5 mb-8">
                                    <div class="w-14 h-14 rounded-2xl bg-blue-500/15 border border-blue-400/20 flex items-center justify-center text-2xl font-black text-blue-300 font-display">W</div>
                                    <div class="flex-1"><p class="text-sm font-bold text-white font-display">WordPress actualizado</p><p class="text-[10px] text-zinc-600 mt-1">Última revisión: hoy</p></div>
                                    <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                </div>
                                <div class="space-y-3">
                                    {[{ label: "Núcleo de WordPress", value: "Actualizado", color: "emerald" }, { label: "Plugins y temas", value: "Verificados", color: "blue" }, { label: "Análisis de seguridad", value: "Sin amenazas", color: "violet" }, { label: "Último respaldo", value: "Completado", color: "cyan" }].map((item) => (
                                        <div class="flex items-center justify-between gap-4 rounded-xl border border-white/[0.06] bg-white/[0.025] px-4 py-3.5"><span class="text-xs text-zinc-400">{item.label}</span><span class:list={["text-[10px] font-bold uppercase tracking-wider", `status-${item.color}`]}>{item.value}</span></div>
                                    ))}
                                </div>
                                <div class="mt-6 rounded-2xl border border-blue-400/15 bg-blue-500/[0.06] p-4 flex items-center gap-4"><div class="w-10 h-10 rounded-xl bg-blue-400/10 flex items-center justify-center"><svg class="w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><div><p class="text-xs font-bold text-white">Equipo de soporte disponible</p><p class="text-[10px] text-zinc-600 mt-1">Tu sitio está en buenas manos</p></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="absolute right-0 top-0 w-[32rem] h-[32rem] rounded-full bg-red-600/[0.03] blur-[140px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-[.9fr_1.1fr] gap-12 lg:gap-24 items-center">
                <div class="reveal">
                    <span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Prevención antes que reparación</span>
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-5 font-display leading-[1.08] tracking-tight">Actualizar WordPress también es proteger tu negocio</h2>
                    <p class="mt-6 text-zinc-500 leading-relaxed">Las actualizaciones mantienen la compatibilidad y corrigen vulnerabilidades. Aplicarlas sin una revisión técnica o sin respaldo puede dejar tu sitio inestable; ignorarlas puede exponerlo a ataques.</p>
                    <p class="mt-4 text-zinc-400 leading-relaxed">Con Grupo Rincón no tienes que preocuparte por ese proceso. Revisamos, respaldamos y actualizamos tu sitio de forma controlada.</p>
                </div>
                <div class="rounded-3xl border border-red-400/10 bg-red-500/[0.035] p-7 sm:p-9 reveal" style="animation-delay: 100ms;">
                    <div class="flex items-center gap-3 mb-7"><span class="w-11 h-11 rounded-2xl bg-red-500/10 border border-red-400/15 flex items-center justify-center"><svg class="w-5 h-5 text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg></span><h3 class="text-lg font-bold text-white font-display">Riesgos más frecuentes</h3></div>
                    <div class="space-y-3">{risks.map((risk) => <div class="flex items-center gap-3 rounded-xl border border-white/[0.06] bg-black/20 p-4"><span class="w-1.5 h-1.5 rounded-full bg-red-400 shrink-0"></span><p class="text-sm text-zinc-400">{risk}</p></div>)}</div>
                </div>
            </div>
        </div>
    </section>

    <section id="planes" class="relative bg-black py-20 lg:py-28 overflow-hidden scroll-mt-24">
        <div class="absolute inset-0 support-grid opacity-20" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-20 reveal">
                <span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Planes de mantenimiento</span>
                <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mt-5 font-display leading-[1.05] tracking-tight">El cuidado que tu sitio necesita</h2>
                <p class="mt-6 text-zinc-500 text-base sm:text-lg">Elige un plan mensual o cuéntanos qué necesitas para preparar una propuesta personalizada.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 items-stretch">
                {plans.map((plan, i) => (
                    <article class:list={["relative rounded-3xl p-7 flex flex-col reveal transition-transform duration-300 hover:-translate-y-1", plan.featured ? "border border-blue-400/35 bg-gradient-to-b from-blue-950/70 to-zinc-950 shadow-xl shadow-blue-950/30" : plan.custom ? "border border-violet-400/25 bg-gradient-to-b from-violet-950/30 to-zinc-950" : "border border-white/[0.08] bg-zinc-950/85"]} style={`animation-delay: ${i * 80}ms`}>
                        {plan.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 text-[9px] font-black text-white uppercase tracking-[0.18em] bg-secondary-500 px-4 py-1.5 rounded-full shadow-lg shadow-blue-900/40">Más popular</span>}
                        <span class:list={["text-[9px] font-bold uppercase tracking-[0.18em] font-display", plan.custom ? "text-violet-300" : "text-blue-300"]}>{plan.eyebrow}</span>
                        <h3 class="text-2xl font-black text-white mt-3 font-display">Plan {plan.name}</h3>
                        <p class="text-xs text-zinc-600 leading-relaxed mt-3 min-h-12">{plan.description}</p>
                        <div class="mt-7 pb-7 border-b border-white/[0.07]">
                            {plan.custom ? <p class="text-3xl font-black text-white font-display">{plan.price}</p> : <div class="flex items-end gap-2"><span class="text-5xl font-black text-white font-display">${plan.price}</span><span class="text-xs text-zinc-500 pb-1">{plan.suffix}</span></div>}
                            {plan.custom && <p class="text-xs text-zinc-500 mt-2">{plan.suffix}</p>}
                        </div>
                        <ul class="mt-7 space-y-3 flex-1">
                            {plan.features.map((feature) => <li class="flex items-start gap-3 text-xs text-zinc-400 leading-relaxed"><svg class:list={["w-4 h-4 mt-0.5 shrink-0", plan.custom ? "text-violet-400" : "text-emerald-400"]} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><span>{feature}</span></li>)}
                        </ul>
                        <a href={getWhatsAppURL(plan.name)} target="_blank" rel="noopener noreferrer" class:list={["mt-8 w-full inline-flex items-center justify-center gap-2 rounded-full px-5 py-3.5 text-xs font-bold transition-all duration-300", plan.featured ? "glow-btn bg-secondary-500 hover:bg-secondary-600 text-white shadow-lg shadow-blue-900/30" : plan.custom ? "bg-violet-500/15 hover:bg-violet-500/25 border border-violet-400/25 text-violet-200" : "bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-zinc-200"]}>{plan.custom ? "Consultar mi plan" : "Solicitar este plan"}<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
                    </article>
                ))}
            </div>

            <div class="mt-8 rounded-2xl border border-white/[0.07] bg-white/[0.025] p-5 sm:p-6 flex flex-col md:flex-row md:items-center gap-5 reveal">
                <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-400/15 flex items-center justify-center shrink-0"><svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2M5 9h14l1 12H4L5 9z"></path></svg></div>
                <div><h3 class="text-sm font-bold text-white font-display">Métodos de pago</h3><p class="text-xs text-zinc-500 leading-relaxed mt-1">Aceptamos efectivo, USDT y transferencias internacionales. Los pagos en bolívares se calculan según la tasa oficial vigente al momento del pago.</p></div>
            </div>
        </div>
    </section>

    <section class="relative bg-[#f6f8fc] py-20 lg:py-28 overflow-hidden text-slate-900">
        <div class="absolute -top-32 -right-24 w-[34rem] h-[34rem] rounded-full bg-blue-200/40 blur-[120px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mb-14 lg:mb-18 reveal"><span class="inline-flex text-[10px] font-bold text-blue-700 uppercase tracking-[0.2em] bg-blue-100 border border-blue-200 px-3.5 py-1.5 rounded-full font-display">Beneficios del servicio</span><h2 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black mt-5 font-display leading-[1.06] tracking-tight">Tranquilidad para ti.<br />Continuidad para tu sitio.</h2></div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                {benefits.map((benefit, i) => <article class="bg-white border border-slate-200/80 rounded-3xl p-7 shadow-sm reveal" style={`animation-delay: ${i * 80}ms`}><div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center mb-6"><svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={benefit.icon}></path></svg></div><h3 class="text-lg font-bold text-slate-900 font-display">{benefit.title}</h3><p class="mt-3 text-sm text-slate-500 leading-relaxed">{benefit.description}</p></article>)}
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16 reveal"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Preguntas frecuentes</span><h2 class="text-4xl sm:text-5xl font-black text-white mt-5 font-display tracking-tight">Antes de comenzar</h2></div>
            <div class="space-y-3">
                {faqs.map((faq, i) => <details class="faq-item group rounded-2xl border border-white/[0.07] bg-black/30 overflow-hidden reveal" style={`animation-delay: ${i * 70}ms`}><summary class="flex items-center justify-between gap-6 p-5 sm:p-6 cursor-pointer list-none"><h3 class="text-sm sm:text-base font-bold text-zinc-200 font-display">{faq.question}</h3><span class="faq-plus w-8 h-8 rounded-full border border-white/10 bg-white/[0.03] flex items-center justify-center shrink-0 text-zinc-400 transition-transform duration-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></span></summary><div class="px-5 sm:px-6 pb-6 -mt-1"><p class="text-sm text-zinc-500 leading-relaxed max-w-3xl">{faq.answer}</p></div></details>)}
            </div>
        </div>
    </section>

    <section class="relative bg-black py-20 lg:py-28 overflow-hidden">
        <div class="absolute inset-0 support-grid opacity-25" aria-hidden="true"></div>
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[42rem] h-[26rem] rounded-full bg-blue-600/10 blur-[140px]" aria-hidden="true"></div>
        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
