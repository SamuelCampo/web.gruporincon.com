---
import Layout from "../../layouts/Layout.astro";

const title = "Desarrollo de Apps Móviles con Flutter y React Native | Grupo Rincón";
const description =
    "Desarrollamos aplicaciones móviles híbridas para iOS y Android con Flutter y React Native. Apps rápidas, escalables y conectadas con tu negocio. Solicita un diagnóstico gratuito.";

const solutions = [
    {
        title: "Apps para clientes",
        description: "Experiencias móviles para vender, reservar, comprar, consultar servicios y fidelizar a tus usuarios.",
        tag: "B2C",
        icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
    },
    {
        title: "Apps empresariales",
        description: "Herramientas internas para ventas, inventario, logística, operaciones y trabajo de equipos en campo.",
        tag: "B2B",
        icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h-4m-10 0H3m6-14h1m-1 4h1m4-4h1m-1 4h1m-6 10v-3a1 1 0 011-1h2a1 1 0 011 1v3m-4 0h4",
    },
    {
        title: "MVP para startups",
        description: "Validamos tu idea con una primera versión funcional, medible y preparada para evolucionar.",
        tag: "Producto digital",
        icon: "M13 10V3L4 14h7v7l9-11h-7z",
    },
    {
        title: "Integraciones y APIs",
        description: "Conectamos la app con tu CRM, ERP, e-commerce, pagos, mapas, notificaciones y sistemas actuales.",
        tag: "Ecosistema conectado",
        icon: "M8 9l3 3-3 3m5 0h3m-9 4h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z",
    },
];

const benefits = [
    "Una sola base tecnológica para iOS y Android",
    "Menor tiempo de desarrollo y salida al mercado",
    "Experiencias fluidas y consistentes",
    "Integración con servicios nativos del dispositivo",
    "Arquitectura preparada para crecer",
    "Mantenimiento centralizado y evolución continua",
];

const process = [
    { number: "01", title: "Descubrimiento", description: "Definimos objetivos, usuarios, funciones prioritarias y métricas de éxito." },
    { number: "02", title: "UX/UI", description: "Diseñamos los flujos, prototipos y la interfaz antes de comenzar a programar." },
    { number: "03", title: "Desarrollo", description: "Construimos la app por etapas con Flutter o React Native según el proyecto." },
    { number: "04", title: "Pruebas", description: "Validamos rendimiento, seguridad y funcionamiento en dispositivos iOS y Android." },
    { number: "05", title: "Publicación", description: "Preparamos el lanzamiento en App Store y Google Play y acompañamos su evolución." },
];

const technologies = [
    { name: "Flutter", detail: "Dart · UI consistente" },
    { name: "React Native", detail: "JavaScript · Ecosistema React" },
    { name: "Firebase", detail: "Auth · Push · Analytics" },
    { name: "APIs REST", detail: "Datos e integraciones" },
    { name: "AWS", detail: "Backend escalable" },
    { name: "App Store & Play", detail: "Publicación y soporte" },
];

const projectTypes = [
    "Crear una app desde cero",
    "Desarrollar un MVP",
    "Modernizar una app existente",
    "Crear una app interna para mi empresa",
    "Integrar una app con mis sistemas",
    "Aún no estoy seguro",
];

const faqs = [
    {
        question: "¿Qué es una aplicación móvil híbrida?",
        answer: "Es una aplicación desarrollada con una base tecnológica compartida que permite ofrecer una experiencia para iOS y Android, reduciendo duplicación de trabajo sin renunciar a una interfaz de calidad.",
    },
    {
        question: "¿Es mejor Flutter o React Native?",
        answer: "Depende del producto, el equipo, las integraciones y la tecnología existente. Evaluamos cada proyecto para recomendar Flutter o React Native con criterios técnicos y de negocio.",
    },
    {
        question: "¿También desarrollan el backend y las APIs?",
        answer: "Sí. Podemos construir el backend, base de datos, panel administrativo e integraciones necesarias para que la aplicación funcione como una solución completa.",
    },
    {
        question: "¿Ayudan a publicar la aplicación en las tiendas?",
        answer: "Sí. Preparamos los recursos técnicos y acompañamos el proceso de publicación en Google Play y App Store, sujeto a las políticas y aprobaciones de cada plataforma.",
    },
    {
        question: "¿Cuánto tiempo toma desarrollar una app móvil?",
        answer: "Un MVP puede requerir entre 6 y 12 semanas. Productos con más módulos o integraciones necesitan un cronograma mayor, que definimos después del diagnóstico inicial.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <section class="relative min-h-screen flex items-center overflow-hidden bg-black">
        <div class="absolute inset-0 mobile-grid opacity-45" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/5 via-black/20 to-black" aria-hidden="true"></div>
        <div class="absolute -top-24 left-[8%] w-[36rem] h-[36rem] rounded-full bg-blue-600/10 blur-[150px]" aria-hidden="true"></div>
        <div class="absolute -bottom-20 right-[4%] w-[32rem] h-[32rem] rounded-full bg-violet-600/[0.09] blur-[140px]" aria-hidden="true"></div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 lg:pt-40 lg:pb-28">
            <div class="grid grid-cols-1 lg:grid-cols-[1.04fr_.96fr] gap-14 lg:gap-20 items-center">
                <div class="reveal">
                    <div class="inline-flex items-center gap-2.5 rounded-full border border-blue-400/20 bg-blue-500/10 px-4 py-2 mb-8">
                        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-blue-400"></span></span>
                        <span class="text-[10px] sm:text-xs font-bold text-blue-300 tracking-[0.18em] uppercase font-display">Una app · iOS y Android</span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl lg:text-[4.25rem] font-black text-white leading-[1.02] tracking-tight font-display">
                        Desarrollo de apps móviles<br class="hidden sm:block" />
                        <span class="bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-400 bg-clip-text text-transparent">con Flutter y React Native</span>
                    </h1>
                    <p class="mt-7 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-2xl">Creamos aplicaciones híbridas rápidas, intuitivas y escalables que conectan tu negocio con usuarios de iOS y Android desde una estrategia tecnológica unificada.</p>
                    <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                        <a href="#diagnostico" class="glow-btn inline-flex justify-center items-center gap-2.5 bg-secondary-500 hover:bg-secondary-600 text-white px-7 py-4 rounded-full text-sm font-bold tracking-wide transition-all duration-300 shadow-lg shadow-blue-900/40">Cotizar mi aplicación <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
                        <a href="#tecnologias" class="inline-flex justify-center items-center gap-2 border border-white/15 hover:border-white/30 bg-white/[0.03] hover:bg-white/[0.07] text-zinc-200 px-7 py-4 rounded-full text-sm font-semibold transition-all duration-300">Flutter vs. React Native</a>
                    </div>
                    <div class="mt-10 pt-7 border-t border-white/[0.07] flex flex-wrap gap-x-8 gap-y-4 text-xs text-zinc-500 font-display">
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Diseño UX/UI incluido</span>
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Arquitectura escalable</span>
                    </div>
                </div>

                <div class="hidden md:flex items-center justify-center reveal" style="animation-delay: 180ms;">
                    <div class="relative w-full max-w-lg h-[34rem]">
                        <div class="absolute inset-0 bg-blue-500/[0.08] blur-[90px] rounded-full"></div>
                        <div class="phone phone-back absolute left-5 lg:left-8 top-12 w-[15rem] h-[29rem] rounded-[2.7rem] border border-white/10 bg-zinc-950/90 p-2.5 rotate-[-7deg] shadow-2xl shadow-black/60">
                            <div class="h-full rounded-[2.15rem] overflow-hidden bg-gradient-to-b from-violet-950/80 to-black border border-white/[0.06] p-5">
                                <div class="w-16 h-5 rounded-full bg-black mx-auto mb-8"></div>
                                <div class="flex items-center justify-between"><div><p class="text-[9px] text-violet-300 uppercase tracking-wider">Resumen</p><p class="text-lg font-black text-white font-display mt-1">Tu negocio</p></div><div class="w-9 h-9 rounded-full bg-violet-500/20"></div></div>
                                <div class="mt-7 h-28 rounded-2xl bg-gradient-to-br from-violet-500/25 to-blue-500/10 border border-violet-400/15 p-4"><div class="h-2 w-16 rounded-full bg-white/15"></div><div class="mt-5 h-6 w-24 rounded-full bg-white/80"></div><div class="mt-3 h-2 w-12 rounded-full bg-emerald-400/70"></div></div>
                                <div class="grid grid-cols-2 gap-3 mt-4"><div class="h-20 rounded-2xl bg-white/[0.04] border border-white/[0.06]"></div><div class="h-20 rounded-2xl bg-white/[0.04] border border-white/[0.06]"></div></div>
                                <div class="mt-4 h-16 rounded-2xl bg-white/[0.04] border border-white/[0.06]"></div>
                            </div>
                        </div>
                        <div class="phone absolute right-5 lg:right-8 top-0 w-[15rem] h-[29rem] rounded-[2.7rem] border border-blue-400/20 bg-zinc-950 p-2.5 rotate-[6deg] shadow-2xl shadow-blue-950/40">
                            <div class="h-full rounded-[2.15rem] overflow-hidden bg-gradient-to-b from-blue-950/90 to-black border border-white/[0.07] p-5">
                                <div class="w-16 h-5 rounded-full bg-black mx-auto mb-8"></div>
                                <div class="w-12 h-12 rounded-2xl bg-blue-500/20 border border-blue-400/15 flex items-center justify-center"><svg class="w-6 h-6 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg></div>
                                <p class="mt-6 text-2xl font-black text-white font-display">Todo en<br />tu mano.</p>
                                <p class="mt-3 text-[10px] text-zinc-500 leading-relaxed">Una experiencia diseñada para acompañar a tus usuarios donde estén.</p>
                                <div class="mt-7 space-y-3"><div class="h-12 rounded-xl bg-blue-500/15 border border-blue-400/15"></div><div class="h-12 rounded-xl bg-white/[0.04] border border-white/[0.06]"></div><div class="h-12 rounded-xl bg-white/[0.04] border border-white/[0.06]"></div></div>
                                <div class="mt-7 h-10 rounded-full bg-secondary-500 shadow-lg shadow-blue-900/40"></div>
                            </div>
                        </div>
                        <span class="absolute right-0 bottom-8 rounded-full border border-white/10 bg-zinc-950/90 backdrop-blur px-4 py-2 text-[10px] font-bold text-zinc-300 shadow-xl">iOS + Android</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="absolute right-0 top-0 w-[32rem] h-[32rem] rounded-full bg-blue-600/[0.04] blur-[130px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-[.86fr_1.14fr] gap-12 lg:gap-24 items-start">
                <div class="reveal lg:sticky lg:top-36"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Desarrollo multiplataforma</span><h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-5 font-display leading-[1.08] tracking-tight">Llega a más usuarios con una estrategia móvil eficiente</h2></div>
                <div class="reveal" style="animation-delay: 100ms;"><p class="text-lg sm:text-xl text-zinc-300 leading-relaxed">Una app híbrida permite construir para iOS y Android con una base tecnológica compartida, acelerando el lanzamiento y simplificando su evolución.</p><p class="mt-6 text-base text-zinc-500 leading-relaxed">En Grupo Rincón elegimos entre <strong class="text-zinc-300">Flutter y React Native</strong> según la experiencia, integraciones, ecosistema y objetivos reales del producto. La tecnología se adapta al proyecto, no al contrario.</p><div class="mt-10 grid grid-cols-2 gap-4"><div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-6"><p class="text-3xl font-black text-white font-display">2</p><p class="text-sm text-zinc-500 mt-2">Plataformas principales</p></div><div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-6"><p class="text-3xl font-black text-white font-display">1</p><p class="text-sm text-zinc-500 mt-2">Estrategia de producto</p></div></div></div>
            </div>
        </div>
    </section>

    <section class="relative bg-black py-20 lg:py-28 overflow-hidden">
        <div class="absolute inset-0 mobile-grid opacity-20" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mb-14 lg:mb-20 reveal"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Soluciones móviles</span><h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mt-5 font-display leading-[1.05] tracking-tight">Apps que resuelven necesidades reales</h2><p class="mt-6 text-zinc-500 text-base sm:text-lg max-w-2xl">Diseñamos productos móviles alrededor de tus usuarios, procesos y objetivos de negocio.</p></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">{solutions.map((solution, i) => <article class="group rounded-3xl border border-white/[0.07] bg-zinc-950/80 p-7 lg:p-8 reveal transition-all duration-300 hover:-translate-y-1 hover:border-blue-400/20" style={`animation-delay: ${i * 80}ms`}><div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-400/15 flex items-center justify-center mb-7"><svg class="w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={solution.icon}></path></svg></div><span class="text-[9px] font-bold text-zinc-600 uppercase tracking-[0.18em] font-display">{solution.tag}</span><h3 class="text-xl sm:text-2xl font-bold text-white mt-3 mb-4 font-display tracking-tight">{solution.title}</h3><p class="text-sm text-zinc-500 leading-relaxed">{solution.description}</p></article>)}</div>
        </div>
    </section>

    <section id="tecnologias" class="relative bg-[#f6f8fc] py-20 lg:py-28 overflow-hidden text-slate-900 scroll-mt-24">
        <div class="absolute -top-32 -right-24 w-[34rem] h-[34rem] rounded-full bg-blue-200/40 blur-[120px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18 reveal"><span class="inline-flex text-[10px] font-bold text-blue-700 uppercase tracking-[0.2em] bg-blue-100 border border-blue-200 px-3.5 py-1.5 rounded-full font-display">La tecnología correcta</span><h2 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black mt-5 font-display leading-[1.06] tracking-tight">Flutter o React Native según tu producto</h2><p class="mt-6 text-slate-600 text-lg">Ambas tecnologías permiten crear aplicaciones multiplataforma sólidas. La elección depende de tu contexto.</p></div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
                <article class="bg-slate-950 rounded-[2rem] p-8 sm:p-10 text-white reveal"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-2xl bg-cyan-400/10 border border-cyan-300/15 flex items-center justify-center text-cyan-300 font-black font-display">F</div><div><span class="text-[9px] text-cyan-300 uppercase tracking-[0.18em] font-bold">Dart</span><h3 class="text-2xl font-black font-display">Flutter</h3></div></div><p class="mt-7 text-sm text-zinc-400 leading-relaxed">Ideal cuando el producto necesita una interfaz visual altamente consistente, control detallado de componentes y una experiencia homogénea entre plataformas.</p><div class="mt-7 space-y-3">{["Sistema visual consistente", "Componentes altamente personalizables", "Buen rendimiento multiplataforma"].map((item) => <div class="flex items-center gap-3 text-sm text-zinc-300"><svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>{item}</div>)}</div></article>
                <article class="bg-white border border-slate-200 rounded-[2rem] p-8 sm:p-10 shadow-sm reveal" style="animation-delay: 100ms;"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-700 font-black font-display">R</div><div><span class="text-[9px] text-blue-700 uppercase tracking-[0.18em] font-bold">JavaScript / TypeScript</span><h3 class="text-2xl font-black font-display">React Native</h3></div></div><p class="mt-7 text-sm text-slate-500 leading-relaxed">Una gran alternativa cuando existe experiencia en React, se busca compartir conocimientos con equipos web o aprovechar su amplio ecosistema.</p><div class="mt-7 space-y-3">{["Ecosistema React", "Amplia comunidad y librerías", "Integración con equipos JavaScript"].map((item) => <div class="flex items-center gap-3 text-sm text-slate-700"><svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>{item}</div>)}</div></article>
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-[.82fr_1.18fr] gap-14 lg:gap-24 items-center">
                <div class="reveal"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] font-display">Ventajas del enfoque híbrido</span><h2 class="text-4xl sm:text-5xl font-black text-white mt-4 font-display leading-[1.07] tracking-tight">Más alcance.<br />Menos duplicación.</h2><p class="mt-6 text-zinc-500 leading-relaxed">Centraliza el desarrollo sin perder de vista la experiencia que esperan los usuarios de cada plataforma.</p></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 reveal" style="animation-delay: 100ms;">{benefits.map((benefit, i) => <div class="flex items-center gap-4 rounded-2xl border border-white/[0.07] bg-black/30 p-5"><span class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-400/10 flex items-center justify-center text-[10px] font-black text-blue-300 font-display shrink-0">{String(i + 1).padStart(2, "0")}</span><p class="text-sm font-medium text-zinc-300 leading-snug">{benefit}</p></div>)}</div>
            </div>
        </div>
    </section>

    <section class="relative bg-black py-20 lg:py-28 overflow-hidden">
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-20 reveal"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Nuestro proceso</span><h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mt-5 font-display leading-[1.05] tracking-tight">De la idea a las tiendas</h2></div>
            <div class="relative"><div class="hidden lg:block absolute top-8 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-blue-500/40 to-transparent"></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5">{process.map((step, i) => <article class="relative rounded-3xl border border-white/[0.07] bg-zinc-950/70 p-6 reveal" style={`animation-delay: ${i * 80}ms`}><div class="relative z-10 w-16 h-16 rounded-2xl border border-blue-500/20 bg-black flex items-center justify-center mb-7"><span class="text-sm font-black text-blue-300 font-display">{step.number}</span></div><h3 class="text-lg font-bold text-white font-display">{step.title}</h3><p class="mt-3 text-sm text-zinc-600 leading-relaxed">{step.description}</p></article>)}</div></div>
        </div>
    </section>

    <section class="bg-zinc-950 py-20 lg:py-28 border-y border-white/[0.05]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12 reveal"><div class="max-w-2xl"><span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] font-display">Tecnologías</span><h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-4 font-display tracking-tight">Un ecosistema listo para crecer</h2></div><p class="max-w-md text-zinc-500 leading-relaxed">Combinamos la app con servicios cloud, analítica, notificaciones y APIs según las necesidades del producto.</p></div><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">{technologies.map((tech, i) => <div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] px-5 py-6 reveal" style={`animation-delay: ${i * 60}ms`}><div class="w-2 h-2 rounded-full bg-blue-400 mb-5 shadow-[0_0_12px_rgba(96,165,250,.7)]"></div><p class="text-sm font-bold text-white font-display">{tech.name}</p><p class="mt-1.5 text-[10px] text-zinc-600 leading-relaxed">{tech.detail}</p></div>)}</div></div>
    </section>

    <section class="relative bg-black py-20 lg:py-28 overflow-hidden">
