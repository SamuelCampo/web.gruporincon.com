<script>
    const mobileContactForm = document.querySelector<HTMLFormElement>("#mobile-contact-form");
    mobileContactForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!mobileContactForm.reportValidity()) return;
        const submitButton = mobileContactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const submitLabel = mobileContactForm.querySelector<HTMLElement>(".submit-label");
        const status = mobileContactForm.querySelector<HTMLElement>("#mobile-form-status");
        const formData = new FormData(mobileContactForm);
        const originalLabel = submitLabel?.textContent || "Enviar datos y continuar en WhatsApp";
        if (submitButton) submitButton.disabled = true;
        if (submitLabel) submitLabel.textContent = "Enviando tus datos...";
        status?.classList.add("hidden");
        try {
            const response = await fetch(mobileContactForm.action, { method: "POST", body: formData, headers: { Accept: "application/json" } });
            if (!response.ok) throw new Error("No fue posible enviar el formulario");
            const name = String(formData.get("nombre") || "").trim();
            const projectType = String(formData.get("tipo_de_proyecto") || "").trim();
            const message = `Hola, soy ${name}. Acabo de completar el formulario para: ${projectType}. Quiero conversar sobre el desarrollo de mi aplicación móvil.`;
            window.location.href = `https://wa.me/584262590251?text=${encodeURIComponent(message)}`;
        } catch {
            if (status) { status.textContent = "No pudimos enviar tus datos. Revisa tu conexión e inténtalo nuevamente."; status.className = "rounded-xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm text-red-300"; }
            if (submitButton) submitButton.disabled = false;
            if (submitLabel) submitLabel.textContent = originalLabel;
        }
    });
</script>

