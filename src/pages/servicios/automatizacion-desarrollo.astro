---
import Layout from "../../layouts/Layout.astro";

const title = "Desarrollo y Automatización de Software a Medida | Grupo Rincón";
const description =
    "Automatizamos tareas repetitivas y creamos sistemas que trabajan por ti 24/7. Desarrollo de software a medida con Laravel, Python y AWS. Solicita tu diagnóstico gratuito.";

const services = [
    {
        title: "Automatización de procesos",
        description:
            "Eliminamos tareas manuales como la carga de datos, generación de reportes, envío de correos, actualización de inventarios y conciliaciones.",
        tag: "RPA & Scripts",
        color: "blue",
        icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
    },
    {
        title: "Software a medida",
        description:
            "Creamos aplicaciones web, paneles administrativos, portales de clientes y sistemas internos adaptados a tu operación real.",
        tag: "Sistemas internos",
        color: "violet",
        icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    },
    {
        title: "Integración de sistemas y APIs",
        description:
            "Conectamos CRM, ERP, e-commerce, hojas de cálculo, WhatsApp y pasarelas de pago para eliminar la doble captura de información.",
        tag: "Datos conectados",
        color: "cyan",
        icon: "M8 9l3 3-3 3m5 0h3m-9 4h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z",
    },
    {
        title: "Automatización con IA",
        description:
            "Desarrollamos bots y flujos inteligentes para clasificar documentos, extraer datos, responder consultas y generar reportes.",
        tag: "Python & IA",
        color: "emerald",
        icon: "M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082M9.75 3.104a24.3 24.3 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19 14.5M14.25 3.104c.251.023.501.05.75.082M19 14.5l-2.25.75M19 14.5l-1.5 1.5M5 14.5l2.25.75M5 14.5l1.5 1.5m8.25-4.5h-5.5",
    },
    {
        title: "Infraestructura en la nube",
        description:
            "Desplegamos soluciones seguras y escalables con monitoreo, copias de respaldo y alta disponibilidad para tu operación.",
        tag: "Cloud & AWS",
        color: "amber",
        icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.2-10A7 7 0 103 15z",
    },
];

const benefits = [
    "Ahorra horas de trabajo manual cada semana",
    "Reduce errores humanos en procesos críticos",
    "Escala sin aumentar el equipo operativo",
    "Decide con datos actualizados en tiempo real",
    "Mantén tus sistemas trabajando 24/7",
];

const process = [
    {
        number: "01",
        title: "Diagnóstico gratuito",
        description:
            "Entendemos tu proceso actual e identificamos los cuellos de botella con mayor impacto.",
    },
    {
        number: "02",
        title: "Propuesta a medida",
        description:
            "Definimos la solución, el alcance, los entregables y un cronograma claro para tu equipo.",
    },
    {
        number: "03",
        title: "Desarrollo",
        description:
            "Construimos por etapas y compartimos avances funcionales para validar temprano cada decisión.",
    },
    {
        number: "04",
        title: "Implementación",
        description:
            "Integramos la solución en tu operación y capacitamos a las personas que la utilizarán.",
    },
    {
        number: "05",
        title: "Mejora continua",
        description:
            "Acompañamos el sistema después del lanzamiento y seguimos optimizando su rendimiento.",
    },
];

const technologies = [
    { name: "Laravel", detail: "Aplicaciones robustas" },
    { name: "Python", detail: "Datos y automatización" },
    { name: "AWS", detail: "Infraestructura cloud" },
    { name: "APIs REST", detail: "Sistemas conectados" },
    { name: "PostgreSQL / MySQL", detail: "Datos confiables" },
    { name: "Docker", detail: "Despliegues consistentes" },
];

const projectTypes = [
    "Automatizar un proceso repetitivo",
    "Desarrollar un sistema a medida",
    "Integrar sistemas o APIs",
    "Implementar una solución con IA",
    "Aún no estoy seguro",
];

const faqs = [
    {
        question: "¿Qué tipo de tareas se pueden automatizar?",
        answer:
            "Cualquier proceso repetitivo basado en reglas claras: generación de reportes, envío de notificaciones, carga de datos, conciliaciones, respuestas a clientes, gestión de inventario y muchos otros.",
    },
    {
        question: "¿Necesito tener sistemas modernos para automatizar mi negocio?",
        answer:
            "No necesariamente. Podemos integrar hojas de cálculo, correos y sistemas existentes mediante APIs o scripts personalizados, sin obligarte a reemplazar todo lo que ya funciona.",
    },
    {
        question: "¿Cuánto tiempo toma desarrollar una automatización o sistema a medida?",
        answer:
            "Depende de la complejidad. Una automatización sencilla puede estar lista en 1 o 2 semanas; un sistema más completo suele requerir entre 4 y 8 semanas.",
    },
    {
        question: "¿Ofrecen soporte después de la implementación?",
        answer:
            "Sí. Nuestros proyectos incluyen un período de soporte y también ofrecemos planes de mantenimiento continuo para acompañar el crecimiento de la solución.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
        },
    })),
};

---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <section class="relative min-h-screen flex items-center overflow-hidden bg-black">
        <div class="absolute inset-0 automation-grid opacity-50" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black" aria-hidden="true"></div>
        <div class="absolute -top-24 left-[12%] h-[34rem] w-[34rem] rounded-full bg-blue-600/10 blur-[150px]" aria-hidden="true"></div>
        <div class="absolute -bottom-24 right-0 h-[30rem] w-[30rem] rounded-full bg-violet-600/10 blur-[140px]" aria-hidden="true"></div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 lg:pt-40 lg:pb-28">
            <div class="grid grid-cols-1 lg:grid-cols-[1.08fr_.92fr] gap-14 lg:gap-16 items-center">
                <div class="reveal">
                    <div class="inline-flex items-center gap-2.5 rounded-full border border-blue-400/20 bg-blue-500/10 px-4 py-2 mb-8">
                        <span class="relative flex h-2 w-2">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-60"></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-400"></span>
                        </span>
                        <span class="text-[10px] sm:text-xs font-bold text-blue-300 tracking-[0.18em] uppercase font-display">Procesos inteligentes · Operación 24/7</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-[4.35rem] font-black text-white leading-[1.02] tracking-tight font-display">
                        Automatización y<br class="hidden sm:block" />
                        desarrollo <span class="bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-400 bg-clip-text text-transparent">a medida</span>
                    </h1>

                    <p class="mt-7 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-2xl">
                        Construimos sistemas que trabajan por ti, 24 horas al día, 7 días a la semana: sin errores humanos, sin tareas repetidas y sin tiempo perdido.
                    </p>

                    <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                        <a href="#diagnostico" class="glow-btn inline-flex justify-center items-center gap-2.5 bg-secondary-500 hover:bg-secondary-600 text-white px-7 py-4 rounded-full text-sm font-bold tracking-wide transition-all duration-300 shadow-lg shadow-blue-900/40">
                            Solicita tu diagnóstico gratuito
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                        <a href="/#portafolio" class="inline-flex justify-center items-center gap-2 border border-white/15 hover:border-white/30 bg-white/[0.03] hover:bg-white/[0.07] text-zinc-200 px-7 py-4 rounded-full text-sm font-semibold transition-all duration-300">
                            Ver casos de éxito
                        </a>
                    </div>

                    <div class="mt-10 pt-7 border-t border-white/[0.07] flex flex-wrap items-center gap-x-8 gap-y-4 text-xs text-zinc-500 font-display">
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Diagnóstico sin costo</span>
                        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Solución 100% personalizada</span>
                    </div>
                </div>

                <div class="hidden md:block reveal" style="animation-delay: 180ms;">
                    <div class="relative max-w-xl mx-auto">
                        <div class="absolute -inset-12 bg-blue-500/[0.08] blur-[80px] rounded-full"></div>
                        <div class="relative rounded-[2rem] border border-white/10 bg-zinc-950/80 backdrop-blur-xl shadow-2xl shadow-blue-950/30 overflow-hidden">
                            <div class="flex items-center justify-between px-5 py-4 border-b border-white/[0.07] bg-white/[0.02]">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
                                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70"></span>
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70"></span>
                                </div>
                                <span class="text-[10px] text-zinc-500 font-mono">workflow_grupo_rincon</span>
                                <span class="inline-flex items-center gap-1.5 text-[9px] font-bold text-emerald-300 bg-emerald-400/10 border border-emerald-400/15 px-2.5 py-1 rounded-full uppercase tracking-wider"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Activo</span>
                            </div>

                            <div class="p-6 sm:p-8 space-y-5">
                                <div class="flex items-center gap-4">
                                    <div class="w-11 h-11 rounded-xl bg-blue-500/15 border border-blue-400/20 flex items-center justify-center shrink-0">
                                        <svg class="w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
                                    </div>
                                    <div class="flex-1">
                                        <div class="flex justify-between gap-4 mb-2"><span class="text-xs font-bold text-white font-display">Nueva solicitud recibida</span><span class="text-[10px] text-zinc-600">08:42</span></div>
                                        <div class="h-1.5 rounded-full bg-white/5 overflow-hidden"><div class="h-full w-full rounded-full bg-blue-500"></div></div>
                                    </div>
                                </div>

                                <div class="ml-5 h-7 border-l border-dashed border-blue-500/30"></div>

                                <div class="grid grid-cols-2 gap-3">
                                    <div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">
                                        <div class="w-8 h-8 rounded-lg bg-violet-500/15 flex items-center justify-center mb-3"><svg class="w-4 h-4 text-violet-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                                        <p class="text-[11px] font-bold text-zinc-200 font-display">Datos validados</p>
                                        <p class="text-[9px] text-zinc-600 mt-1">Sin intervención manual</p>
                                    </div>
                                    <div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">
                                        <div class="w-8 h-8 rounded-lg bg-cyan-500/15 flex items-center justify-center mb-3"><svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10M4 18h10"></path></svg></div>
                                        <p class="text-[11px] font-bold text-zinc-200 font-display">CRM actualizado</p>
                                        <p class="text-[9px] text-zinc-600 mt-1">API sincronizada</p>
                                    </div>
                                </div>

                                <div class="ml-5 h-7 border-l border-dashed border-blue-500/30"></div>

                                <div class="rounded-2xl border border-emerald-400/15 bg-emerald-400/[0.06] p-4 flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-xl bg-emerald-400/15 flex items-center justify-center shrink-0"><svg class="w-5 h-5 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>
                                    <div class="flex-1"><p class="text-xs font-bold text-white font-display">Proceso completado</p><p class="text-[10px] text-emerald-300/70 mt-1">Tiempo total: 1.8 segundos</p></div>
                                    <span class="text-[10px] text-zinc-500 line-through">25 min</span>
                                </div>
                            </div>

                            <div class="grid grid-cols-3 border-t border-white/[0.07] bg-white/[0.015]">
                                <div class="p-4 text-center border-r border-white/[0.07]"><p class="text-lg font-black text-white font-display">98%</p><p class="text-[9px] text-zinc-600 uppercase tracking-wider">Automático</p></div>
                                <div class="p-4 text-center border-r border-white/[0.07]"><p class="text-lg font-black text-white font-display">24/7</p><p class="text-[9px] text-zinc-600 uppercase tracking-wider">Disponible</p></div>
                                <div class="p-4 text-center"><p class="text-lg font-black text-white font-display">0</p><p class="text-[9px] text-zinc-600 uppercase tracking-wider">Errores</p></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="absolute right-0 top-0 w-[32rem] h-[32rem] bg-blue-600/[0.04] rounded-full blur-[120px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-[.82fr_1.18fr] gap-12 lg:gap-24 items-start">
                <div class="reveal lg:sticky lg:top-36">
                    <span class="inline-flex text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Menos operación, más crecimiento</span>
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mt-5 font-display leading-[1.08] tracking-tight">El trabajo repetitivo no debería frenar a tu equipo</h2>
                </div>
                <div class="reveal" style="animation-delay: 100ms;">
                    <p class="text-lg sm:text-xl text-zinc-300 leading-relaxed">Cada hora que tu equipo dedica a copiar datos entre sistemas, generar reportes manuales o responder los mismos correos es una hora que no está generando valor para tu negocio.</p>
                    <p class="mt-6 text-base text-zinc-500 leading-relaxed">En Grupo Rincón diseñamos <strong class="text-zinc-300 font-semibold">software a medida y sistemas de automatización</strong> que eliminan esas tareas, conectan tus herramientas actuales y permiten que tu operación funcione incluso cuando tú no estás mirando.</p>
                    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-6"><p class="text-3xl font-black text-white font-display">100%</p><p class="text-sm text-zinc-500 mt-2">Diseñado alrededor de tu proceso real</p></div>
                        <div class="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-6"><p class="text-3xl font-black text-white font-display">24/7</p><p class="text-sm text-zinc-500 mt-2">Sistemas disponibles para tu operación</p></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative bg-black py-20 lg:py-28 overflow-hidden">
        <div class="absolute inset-0 automation-grid opacity-20" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mb-14 lg:mb-20 reveal">
                <span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Servicios especializados</span>
                <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mt-5 font-display leading-[1.05] tracking-tight">Tecnología construida alrededor de tu negocio</h2>
                <p class="mt-6 text-zinc-400 text-base sm:text-lg leading-relaxed max-w-2xl">No adaptamos tu operación a una plantilla. Analizamos cómo trabaja tu empresa y construimos la solución exacta para hacerla más ágil.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
                {services.map((service, i) => (
                    <article class:list={["service-card group rounded-3xl border border-white/[0.07] bg-zinc-950/80 p-7 lg:p-8 reveal", i < 2 ? "lg:col-span-3" : "lg:col-span-2"]} style={`animation-delay: ${i * 70}ms`}>
                        <div class:list={["w-12 h-12 rounded-2xl flex items-center justify-center mb-7 border", `service-icon-${service.color}`]}>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={service.icon}></path></svg>
                        </div>
                        <span class="text-[9px] font-bold text-zinc-600 uppercase tracking-[0.18em] font-display">{service.tag}</span>
                        <h3 class="text-xl sm:text-2xl font-bold text-white mt-3 mb-4 font-display tracking-tight">{service.title}</h3>
                        <p class="text-sm text-zinc-500 leading-relaxed">{service.description}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="relative bg-[#f6f8fc] py-20 lg:py-28 overflow-hidden text-slate-900">
        <div class="absolute -top-32 -right-24 w-[34rem] h-[34rem] rounded-full bg-blue-200/40 blur-[120px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-24 items-center">
                <div class="reveal">
                    <span class="inline-flex text-[10px] font-bold text-blue-700 uppercase tracking-[0.2em] bg-blue-100 border border-blue-200 px-3.5 py-1.5 rounded-full font-display">Impacto medible</span>
                    <h2 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black mt-5 font-display leading-[1.06] tracking-tight">Más capacidad sin sumar complejidad</h2>
                    <p class="mt-6 text-slate-600 text-lg leading-relaxed">Libera a tu equipo para que se enfoque en decisiones, clientes y crecimiento. La tecnología se encarga del resto.</p>
                    <a href="#diagnostico" class="mt-9 inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900 transition-colors font-display">Descubre qué puedes automatizar <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
                </div>
                <div class="grid gap-3 reveal" style="animation-delay: 120ms;">
                    {benefits.map((benefit, i) => (
                        <div class="group flex items-center gap-4 bg-white border border-slate-200/80 rounded-2xl p-4 sm:p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
                            <span class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center shrink-0 text-blue-700 font-black text-xs font-display">{String(i + 1).padStart(2, "0")}</span>
                            <p class="text-sm sm:text-base font-semibold text-slate-800">{benefit}</p>
                            <svg class="w-4 h-4 text-blue-600 ml-auto opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="relative bg-zinc-950 py-20 lg:py-28 overflow-hidden">
        <div class="absolute left-0 top-1/3 w-[28rem] h-[28rem] rounded-full bg-violet-600/[0.04] blur-[130px]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-20 reveal">
                <span class="text-[10px] font-bold text-blue-300 uppercase tracking-[0.2em] bg-blue-500/10 border border-blue-500/15 px-3.5 py-1.5 rounded-full font-display">Cómo trabajamos</span>
                <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mt-5 font-display leading-[1.05] tracking-tight">Del proceso manual a una operación inteligente</h2>
                <p class="mt-6 text-zinc-500 text-base sm:text-lg">Un camino claro, colaborativo y sin sorpresas desde el diagnóstico hasta la mejora continua.</p>
            </div>

            <div class="relative">
                <div class="hidden lg:block absolute top-8 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-blue-500/40 to-transparent" aria-hidden="true"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5">
                    {process.map((step, i) => (
                        <article class="relative rounded-3xl border border-white/[0.07] bg-black/40 p-6 reveal" style={`animation-delay: ${i * 80}ms`}>
                            <div class="relative z-10 w-16 h-16 rounded-2xl border border-blue-500/20 bg-zinc-950 flex items-center justify-center mb-7 shadow-lg shadow-black/40">
                                <span class="text-sm font-black text-blue-300 font-display">{step.number}</span>
