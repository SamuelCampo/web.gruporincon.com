---
/**
 * Landings exclusivas de un mercado (p. ej. Caracas sólo en gruporincon.com.ve).
 * Sólo se generan las del mercado que se está compilando; en el otro dominio
 * no existen, así que no hay contenido duplicado.
 */
import DisenoWebCaracas from "../landings/DisenoWebCaracas.astro";
import DesarrolloWebCaracas from "../landings/DesarrolloWebCaracas.astro";
import { LANDINGS } from "../landings/data";
import { MARKET_ID } from "../config/markets";

export function getStaticPaths() {
  return LANDINGS.filter((l) => l.market === MARKET_ID).map((landing) => ({
    params: { landing: landing.slug },
    props: { landing },
  }));
}

const COMPONENTS = {
  "diseno-paginas-web-caracas": DisenoWebCaracas,
  "desarrollo-web-a-medida-caracas": DesarrolloWebCaracas,
} as const;

const { landing } = Astro.props;
const Page = COMPONENTS[landing.slug as keyof typeof COMPONENTS];
---

<Page landing={landing} />
