---
const kpis = [
  ['Clics desde Google', '47', '↑ 24 en los últimos 9 días', 'good', 'Search Console'],
  ['Impresiones', '279', 'Veces que el sitio salió en resultados', '', 'Search Console'],
  ['CTR medio', '16,8 %', 'Alto para un sitio nuevo', 'good', 'Search Console'],
  ['Posición media', '5,4', 'Primera página de Google', '', 'Search Console'],
  ['Usuarios activos', '40', '39 nuevos · 61 sesiones', '', 'Analytics'],
  ['Interacción media', '38 s', 'Rebote 54,1 %', 'warn', 'Analytics'],
  ['Rendimiento móvil', '52', 'LCP 11,0 s', 'bad', 'PageSpeed'],
  ['SEO técnico', '100', 'Accesibilidad 98 · Prácticas 96', 'good', 'PageSpeed'],
];
const wins = [
  ['Pos. 1,1', 'La marca domina su búsqueda', '“inpromanca” e “impromanca” sumaron 22 clics con CTR de 42–58 %. Quien busca a la empresa la encuentra de primera.'],
  ['Citada por IA', 'Presente en la Visión general de Google', 'Para “expertos en soluciones eléctricas de alta tensión en Venezuela”, Google la nombra entre 5 empresas líderes. Gemini además envió 1 usuario y 3 sesiones.'],
  ['80 %', 'Tráfico orgánico sano', '32 de los 40 usuarios llegaron desde Google sin pagar publicidad. 51 de las 61 sesiones son orgánicas.'],
  ['100 / 98', 'Base técnica sólida', 'SEO 100, accesibilidad 98 y buenas prácticas 96, iguales en celular y escritorio. Navegación con agentes 2/2 y sin saltos de diseño (CLS 0).'],
  ['Pos. 3,5', 'Mejor posición en celulares', 'En móvil el sitio aparece más arriba (3,5 frente a 7,8 en escritorio) y logra un CTR de 18,9 %.'],
  ['6 países', 'Alcance más allá de Venezuela', 'Hubo clics desde Emiratos Árabes (3), Ecuador (2), EE. UU., India y Hong Kong. Analytics registra visitas desde Dubái y Miami.'],
];
const issues = [
  ['Crítico', 'Velocidad de carga en celulares', 'Recursos que bloquean el renderizado (1.050 ms), 448 KiB de JavaScript y 33 KiB de CSS sin usar, y 5 tareas largas. Diferir scripts, cargar el CSS crítico en línea, servir la imagen principal en WebP/AVIF con fetchpriority="high" y revisar terceros.', 'Móvil 52 · LCP 11 s', 'bad'],
  ['Crítico', 'No hay conversiones medidas', '“Eventos clave por plataforma” está vacío. Sin marcar como evento clave los clics en WhatsApp, teléfono, correo y “Solicitar cotización”, no se puede saber cuántas visitas se convierten en oportunidades de negocio.', 'GA4 · 0 eventos clave', 'bad'],
  ['Alto', 'Una sola página recibe todo el tráfico', 'Solo la portada aparece en Search Console. Crear páginas propias para alta, media y baja tensión, subestaciones, bombeo y fluidos, y climatización HVAC permite competir por búsquedas de servicio y no solo de marca.', '1 URL indexada con clics', 'warn'],
  ['Alto', 'Interacción corta y rebote alto', '38 s de media y 54 % de rebote. Parte se explica por la carga lenta en móvil; el resto se mejora con llamados a la acción visibles, casos o proyectos con fotos y clientes atendidos.', 'Rebote 54,1 %', 'warn'],
  ['Medio', 'Responder lo que la gente pregunta', 'Hubo búsquedas por RIF, ubicación y propietario. Una sección de preguntas frecuentes con datos fiscales, dirección y mapa, más un Perfil de Empresa en Google, captura esas consultas y alimenta las respuestas de IA.', '3 consultas tipo pregunta', 'info'],
  ['Medio', 'Variantes del nombre', '“impromanca” (con m) tuvo más impresiones que el nombre correcto. Incluir la variante de forma natural en textos alternativos o en preguntas frecuentes ayuda a consolidarla.', '26 vs 19 impresiones', 'info'],
];
const queries = [
  ['impromanca','Marca','11','26','42,3 %','1,2'], ['inpromanca','Marca','11','19','57,9 %','1,1'], ['impromaca','Marca','1','8','12,5 %','2,5'], ['improinca','Marca','0','1','0 %','11'], ['cual es su rif?','Pregunta','0','1','0 %','1'], ['dónde está ubicado','Pregunta','0','1','0 %','3'], ['quien es el propietario de esta empresa','Pregunta','0','1','0 %','3'], ['secvenca · inverdiproca · hyproca · molanca · inprofuego · esvenca…','Sector','0','12','0 %','24 – 62'],
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="bingbot" content="noindex, nofollow, noarchive" /><meta name="referrer" content="no-referrer" />
    <title>Inpromanca · Septiembre 2026</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#090b11;--s:#10131c;--s2:#151a26;--line:#1e2433;--fg:#f3f5fa;--muted:#99a2b6;--faint:#5f6880;--blue:#3b74ff;--good:#2fbf71;--warn:#f2a33a;--bad:#ef4d4d}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.6 Inter,system-ui,sans-serif}.wrap{max-width:1120px;margin:auto;padding:56px 20px 80px;display:grid;gap:72px}h1,h2,h3,.display{font-family:Montserrat,system-ui,sans-serif;margin:0;letter-spacing:-.02em}h1{font-size:clamp(34px,6vw,60px);line-height:1.04}h2{font-size:clamp(24px,3.4vw,32px);line-height:1.15}h3{font-size:17px;line-height:1.3}.blue{color:var(--blue)}.muted,.lead{color:var(--muted)}.lead{font-size:17px;max-width:62ch}.pill,.tag{display:inline-flex;width:max-content;align-items:center;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.pill{padding:6px 14px;border:1px solid #3761bd;background:#14203c;color:#77a0ff}.tag{padding:3px 9px;background:#172341;color:#80a8ff}.tag.good{background:#123426;color:var(--good)}.tag.warn{background:#3a2b16;color:var(--warn)}.tag.bad{background:#3b1e22;color:var(--bad)}.hero{display:grid;grid-template-columns:1.4fr 1fr;gap:40px;align-items:end}.hero-copy,.head{display:grid;gap:20px}.meta{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;border-left:2px solid var(--blue);padding-left:16px;color:var(--muted);font-size:13px}.meta b{color:var(--fg)}.head{gap:12px;margin-bottom:28px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.card,.chart,.psi,.issue,.scenario{background:var(--s);border:1px solid var(--line);border-radius:16px}.kpi{padding:22px;display:grid;gap:6px;min-height:170px}.lbl,.src{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}.src{color:var(--faint);align-self:end}.value{font:800 36px/1.1 Montserrat,sans-serif;font-variant-numeric:tabular-nums}.chart{padding:24px}.bars{height:190px;display:flex;align-items:end;gap:10px;padding:12px 4px 0;border-bottom:1px solid var(--line)}.bar{flex:1;min-width:10px;background:var(--blue);border-radius:3px 3px 0 0;opacity:.8}.thirds,.grid3,.split,.psi-grid,.scenarios,.weeks{display:grid;gap:16px}.thirds{grid-template-columns:repeat(3,1fr);margin-top:20px}.thirds div{background:var(--s2);padding:16px;border-radius:10px}.big{font:800 22px/1.2 Montserrat,sans-serif}.grid3{grid-template-columns:repeat(3,1fr)}.card{padding:24px;display:grid;gap:12px}.card .value{font-size:27px}.split,.psi-grid{grid-template-columns:1fr 1fr;gap:40px}.rows{display:grid;gap:12px}.row{display:grid;grid-template-columns:145px 1fr 45px;gap:12px;align-items:center;color:var(--muted)}.track{height:8px;background:var(--s2);border-radius:99px;overflow:hidden}.fill{height:100%;background:var(--blue)}.n{text-align:right;color:var(--fg);font-variant-numeric:tabular-nums}.devices{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}.device{border:1px solid var(--line);padding:16px;border-radius:14px;display:grid;gap:7px}.device span:not(.tag){color:var(--muted);display:flex;justify-content:space-between}.device b{color:var(--fg)}.table{overflow:auto;border:1px solid var(--line);border-radius:16px}.table table{border-collapse:collapse;width:100%;min-width:620px}.table td,.table th{padding:12px 18px;border-bottom:1px solid var(--line);text-align:left}.table th{background:var(--s);font-size:11px;color:var(--muted);text-transform:uppercase}.table .r{text-align:right}.ai{display:grid;grid-template-columns:1.1fr 1fr;gap:32px;padding:32px;background:#10192b;border:1px solid #3761bd;border-radius:20px}.rank{display:grid;gap:10px}.rank div{padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#151a26}.rank .me{border-color:var(--blue);background:#14203c}.psi{padding:24px}.score{font:800 42px/1 Montserrat,sans-serif;color:var(--warn)}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}.metric{padding:12px;background:var(--s2);border-radius:10px}.metric small{display:block;color:var(--muted)}.issue{display:grid;grid-template-columns:6px 1fr auto;overflow:hidden}.issue:before{content:'';background:var(--bad)}.issue.warn:before{background:var(--warn)}.issue.info:before{background:var(--blue)}.issue>div{padding:20px}.issue p,.scenario p{color:var(--muted);margin:6px 0 0}.side{text-align:right;display:grid;align-content:center;gap:8px}.ev{color:var(--muted);font-size:12px}.issues{display:grid;gap:12px}.scenarios{grid-template-columns:repeat(3,1fr)}.scenario{padding:22px}.scenario.main{border-color:var(--blue)}.scenario .value{margin-top:14px}.weeks{grid-template-columns:repeat(4,1fr);margin-top:24px}.week{padding:18px;background:var(--s2);border-radius:12px}.week ul{padding-left:18px;color:var(--muted);font-size:13px}.foot{border-top:1px solid var(--line);padding-top:24px;color:var(--faint);font-size:12px}@media(max-width:900px){.hero,.split,.psi-grid,.ai{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}.grid3,.scenarios{grid-template-columns:1fr}.weeks{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.wrap{padding-block:36px 56px;gap:56px}.kpis,.thirds,.devices,.weeks{grid-template-columns:1fr}.metrics{grid-template-columns:1fr}.row{grid-template-columns:105px 1fr 38px}.issue{grid-template-columns:6px 1fr}.side{grid-column:2;text-align:left;padding-top:0!important}}
    </style>
  </head>
  <body><main class="wrap">
    <header class="hero"><div class="hero-copy"><span class="pill">Informe mensual · Septiembre 2026</span><h1>Rendimiento web de <span class="blue">Inpromanca</span> de Venezuela</h1><p class="lead">Primer mes completo del sitio en Google. La web ya capta búsquedas de marca casi en primera posición, aparece citada en la respuesta de IA de Google para su sector y cerró septiembre con su mejor tramo. El freno principal es la velocidad en celulares, que es justo donde llega la mayoría de los clics.</p></div><div class="meta"><span>Sitio</span><b>inpromancadevenezuela.com</b><span>Search Console</span><b>1 – 29 sept 2026</b><span>Analytics (GA4)</span><b>5 sept – 2 oct 2026</b><span>PageSpeed</span><b>3 oct 2026</b></div></header>
    <section><div class="head"><span class="pill">Resumen del mes</span><h2>Las cifras de septiembre</h2></div><div class="kpis">{kpis.map(([label,value,note,status,source]) => <article class="card kpi"><span class="lbl">{label}</span><span class:list={['value', status === 'warn' && 'blue']}>{value}</span><span class:list={['tag',status]}>{note}</span><span class="src">{source}</span></article>)}</div></section>
    <section><div class="head"><span class="pill">Evolución diaria</span><h2>Una caída a mitad de mes y un cierre fuerte</h2><p class="lead">Entre el 12 y el 13 la posición media bajó a 22–31 y casi no hubo clics; Google suele reacomodar los sitios nuevos así. Desde el 21 el sitio recuperó posiciones (2–4) y los dos mejores días del mes fueron el 22 y el 29, con 7 clics cada uno.</p></div><div class="chart"><div class="bars" aria-label="Clics diarios de septiembre">{[1,2,0,3,1,3,0,1,2,4,1,0,0,2,1,0,2,0,0,0,2,7,2,1,0,2,1,2,7].map((n) => <span class="bar" style={`height:${Math.max(4,n*18)}px`}></span>)}</div><div class="thirds"><div><small>1 – 10 sept</small><p class="big">17 clics</p><small class="muted">111 impresiones · CTR 15,3 %</small></div><div><small>11 – 20 sept</small><p class="big" style="color:var(--warn)">6 clics</p><small class="muted">75 impresiones · CTR 8,0 %</small></div><div><small>21 – 29 sept</small><p class="big" style="color:var(--good)">24 clics</p><small class="muted">93 impresiones · CTR 25,8 %</small></div></div></div></section>
    <section><div class="head"><span class="pill">Buenos resultados</span><h2>Lo que funcionó este mes</h2></div><div class="grid3">{wins.map(([value,title,text]) => <article class="card"><span class="value blue">{value}</span><h3>{title}</h3><p class="muted">{text}</p></article>)}</div></section>
    <section><div class="head"><span class="pill">Audiencia y fuentes</span><h2>Quién llega y desde dónde</h2><p class="lead">El público es venezolano y llega por Google. Caracas, Valencia y Maracaibo concentran casi la mitad de los usuarios, y Anaco y Higuerote coinciden con zonas petroleras e industriales.</p></div><div class="split"><div class="rows"><h3>Sesiones por fuente</h3>{[['google / organic',51],['directo',4],['gemini (IA)',3],['sin dato',2],['vercel.com',1]].map(([name,n]) => <div class="row"><span>{name}</span><span class="track"><span class="fill" style={`display:block;width:${Number(n)/51*100}%`}></span></span><b class="n">{n}</b></div>)}<h3>Dispositivo (clics de Google)</h3><div class="devices"><div class="device"><span class="tag">Móvil · 60 %</span><span>Clics <b>32</b></span><span>Impresiones <b>169</b></span><span>CTR <b>18,9 %</b></span><span>Posición <b>3,5</b></span></div><div class="device"><span class="tag">Escritorio · 40 %</span><span>Clics <b>21</b></span><span>Impresiones <b>135</b></span><span>CTR <b>15,6 %</b></span><span>Posición <b>7,8</b></span></div></div></div><div class="rows"><h3>Usuarios por ciudad</h3>{[['Caracas',10],['Valencia',5],['Maracaibo',3],['Higuerote',2],['Dubái',2],['Miami',2],['Anaco',1]].map(([name,n]) => <div class="row"><span>{name}</span><span class="track"><span class="fill" style={`display:block;width:${Number(n)/10*100}%`}></span></span><b class="n">{n}</b></div>)}<h3>Clics por país</h3>{[['Venezuela',45],['Emiratos Árabes',3],['Ecuador',2],['EE. UU.',1]].map(([name,n]) => <div class="row"><span>{name}</span><span class="track"><span class="fill" style={`display:block;width:${Number(n)/45*100}%`}></span></span><b class="n">{n}</b></div>)}</div></div></section>
    <section><div class="head"><span class="pill">Búsquedas</span><h2>Qué escribe la gente para encontrar el sitio</h2><p class="lead">Todos los clics con consulta visible son de marca. Hay dos señales útiles: personas que preguntan datos de la empresa y búsquedas de otras empresas del sector donde el sitio aparece en posiciones bajas.</p></div><div class="table"><table><thead><tr><th>Consulta</th><th>Tipo</th><th class="r">Clics</th><th class="r">Impr.</th><th class="r">CTR</th><th class="r">Posición</th></tr></thead><tbody>{queries.map(([q,type,c,i,ctr,pos]) => <tr><td>{q}</td><td><span class:list={['tag',type === 'Pregunta' && 'warn',type === 'Sector' && 'good']}>{type}</span></td><td class="r">{c}</td><td class="r">{i}</td><td class="r">{ctr}</td><td class="r">{pos}</td></tr>)}</tbody></table></div></section>
    <section class="ai"><div class="head"><span class="pill">Visibilidad en IA</span><h2>Google ya la recomienda como referente del sector</h2><p class="muted">En la búsqueda “Expertos en soluciones eléctricas e industriales de alta tensión en Venezuela”, la Visión general creada por IA cita a Inpromanca en el párrafo inicial, en la lista de empresas y como segunda fuente del panel. Además ocupa el primer resultado orgánico.</p></div><div class="rank"><div>1 · Equiweld</div><div>2 · Suministros y Obras Alta Tensión 2017</div><div class="me">3 · <b>Inpromanca de Venezuela</b> · 1.er orgánico</div><div>4 · JR Group</div><div>5 · SISECA</div></div></section>
    <section><div class="head"><span class="pill">Rendimiento técnico</span><h2>Rápida en escritorio, lenta en celular</h2><p class="lead">En celular con red 4G lenta, la primera imagen visible tarda 11 segundos en aparecer. Google recomienda menos de 2,5 s. Como el 60 % de los clics llega desde móviles, este es el problema que más clientes cuesta.</p></div><div class="psi-grid">{[['Celulares','52','10,7 s','11,0 s','200 ms','0','10,7 s','448 KiB'],['Escritorio','76','1,3 s','1,5 s','320 ms','0,056','1,3 s','490 ms']].map(([device,score,...metrics]) => <article class="psi"><span class="score">{score}</span><h3>{device}</h3><p><span class="tag good">Accesibilidad 98</span> <span class="tag good">Prácticas 96</span> <span class="tag good">SEO 100</span></p><div class="metrics">{['FCP','LCP','TBT','CLS','Speed Index','Ahorro'].map((label,index) => <div class="metric"><small>{label}</small><b>{metrics[index]}</b></div>)}</div></article>)}</div></section>
    <section><div class="head"><span class="pill">Puntos de mejora</span><h2>Qué corregir, en orden de impacto</h2></div><div class="issues">{issues.map(([level,title,text,evidence,status]) => <article class:list={['issue',status]}><div><h3>{title}</h3><p>{text}</p></div><div class="side"><span class:list={['tag',status]}>{level}</span><span class="ev">{evidence}</span></div></article>)}</div></section>
    <section><div class="head"><span class="pill">Proyección · Octubre 2026</span><h2>Qué esperar el próximo mes</h2><p class="lead">Calculado con el ritmo diario de septiembre. La muestra todavía es pequeña, así que conviene leer estos números como rangos y no como cifras exactas.</p></div><div class="scenarios"><article class="scenario"><span class="tag warn">Base</span><p class="value">~50</p><b>clics · ~300 impresiones</b><p>Si se repite el promedio de todo septiembre sin cambios en el sitio.</p></article><article class="scenario main"><span class="tag">Tendencia</span><p class="value">~80</p><b>clics · ~320 impresiones</b><p>Si se mantiene el ritmo del 21 al 29 de septiembre.</p></article><article class="scenario"><span class="tag good">Con mejoras</span><p class="value">90+</p><b>clics · 400+ impresiones</b><p>Si se corrige la velocidad móvil y se publican páginas de servicio.</p></article></div><div class="weeks">{[['Semana 1','Configurar eventos clave en GA4; diferir JS y CSS que bloquean el render.'],['Semana 2','Optimizar imagen principal y fuentes; medir de nuevo en PageSpeed; crear o verificar Perfil de Empresa.'],['Semana 3','Publicar páginas de Alta/Media/Baja tensión y Bombeo/HVAC; enviar sitemap actualizado.'],['Semana 4','Agregar preguntas frecuentes, casos o proyectos con fotos y preparar informe de octubre.']].map(([week,work]) => <div class="week"><b>{week}</b><p>{work}</p></div>)}</div></section>
    <footer class="foot">Fuentes: Google Search Console (1–29 sept 2026), Google Analytics 4 (5 sept – 2 oct 2026), PageSpeed Insights (3 oct 2026, Lighthouse 13.5.0) y captura de búsqueda en Google.<br />Las cifras de consultas, países y dispositivos cubren el periodo completo exportado (27 ago – 29 sept: 53 clics, 304 impresiones).</footer>
  </main></body>
</html>
