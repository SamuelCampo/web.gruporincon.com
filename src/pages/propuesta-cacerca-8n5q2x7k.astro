---
import "../styles/propuesta-shopify.css";

const scope = [
  ["01", "Inicio comercial", "Una portada contundente que presente la capacidad técnica de CACERCA y dirija al visitante hacia una cotización o conversación directa."],
  ["02", "Empresa y capacidad", "Perfil corporativo, sectores atendidos, experiencia, cobertura, seguridad y argumentos que refuercen confianza ante ingenieros y empresas."],
  ["03", "Servicios", "Presentación clara de obras eléctricas, electromecánicas, petroleras, civiles, facilidades de superficie y sistemas contra incendio."],
  ["04", "Proyectos ejecutados", "Conversión del material existente en casos de experiencia con necesidad, alcance, fotografías y resultado de cada proyecto."],
  ["05", "Cotizaciones", "Formulario comercial para organizar datos de contacto, empresa, servicio, ubicación y descripción del requerimiento."],
  ["06", "Proveedores", "Sección específica con formulario para registrar empresas, datos fiscales, contacto y tipo de producto o servicio ofrecido."],
];

const features = [
  "Rediseño visual completo con enfoque industrial, energético y corporativo",
  "Diseño adaptable a móvil, tableta y escritorio",
  "Página de inicio orientada a generar oportunidades comerciales",
  "Presentación corporativa y capacidades de la empresa",
  "Sección de líneas de servicio",
  "Sección de proyectos ejecutados",
  "Formulario de solicitud de cotización",
  "Sección y formulario para proveedores",
  "Botones directos de llamada y WhatsApp",
  "Integración de Instagram y canales de contacto",
  "Ubicaciones e información comercial",
  "Recepción organizada de solicitudes por correo",
  "Optimización básica de velocidad",
  "SEO técnico básico: títulos, descripciones y estructura",
  "Medición básica de visitas y conversiones",
  "Configuración sobre el dominio y hosting actual",
  "Una ronda consolidada de correcciones",
  "14 días de garantía técnica posterior al lanzamiento",
];

const phases = [
  ["Días 1–2", "Contenido", "Recepción de accesos, textos, imágenes y organización de la arquitectura comercial."],
  ["Días 3–5", "Diseño", "Construcción visual responsive de las secciones y recorridos principales."],
  ["Días 6–8", "Integración", "Formularios, contactos directos, analítica, SEO básico y configuración técnica."],
  ["Días 9–10", "Entrega", "Pruebas, ronda de ajustes, aprobación final y publicación en el dominio."],
];

const requirements = [
  ["01", "Accesos", "Dominio, hosting actual y cuentas necesarias para publicar y configurar medición."],
  ["02", "Identidad", "Logo en buena calidad, colores disponibles y cualquier material corporativo vigente."],
  ["03", "Contenido", "Textos definitivos de empresa, servicios, ubicaciones, teléfonos, correos y redes sociales."],
  ["04", "Proyectos", "Fotografías y datos autorizados de los proyectos que se convertirán en casos de experiencia."],
  ["05", "Formularios", "Correo receptor y campos definitivos para cotizaciones y registro de proveedores."],
  ["06", "Revisión", "Una devolución consolidada dentro de las 48 horas posteriores a la presentación."],
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="bingbot" content="noindex, nofollow, noarchive" />
    <meta name="GPTBot" content="noindex, nofollow, noarchive" />
    <meta name="CCBot" content="noindex, nofollow, noarchive" />
    <meta name="ClaudeBot" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Propuesta privada para la renovación de presencia digital de CACERCA Energía." />
    <title>Propuesta privada · CACERCA Energía</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav-shell">
      <nav class="nav container" aria-label="Navegación de la propuesta">
        <a class="brand" href="#inicio" aria-label="Grupo Rincón, volver al inicio"><img src="/Logo/Logo blanco.png" alt="Grupo Rincón" width="148" height="52" /></a>
        <div class="nav-links"><a href="#alcance">Alcance</a><a href="#inversion">Inversión</a><a href="#plan">Plan</a><a href="#pagos">Pagos</a></div>
        <a class="button button-small" href="#aceptacion">Aprobar propuesta</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="orb orb-one"></div><div class="orb orb-two"></div><div class="grid-lines"></div>
        <div class="container hero-inner">
          <div class="eyebrow"><span></span> PROPUESTA CONFIDENCIAL · CACERCA ENERGÍA</div>
          <h1>Ingeniería que inspira confianza <em>antes del primer contacto.</em></h1>
          <p class="hero-copy">Renovaremos la presencia digital de CACERCA Energía para convertirla en una plataforma corporativa orientada a presentar capacidades, demostrar experiencia y generar nuevas oportunidades comerciales.</p>
          <div class="hero-actions"><a class="button" href="#inversion">Ver inversión <span>↓</span></a><a class="button button-ghost" href="#alcance">Explorar alcance</a></div>
          <div class="hero-note"><span class="lock">●</span> Documento privado · válido por 15 días</div>
        </div>
      </section>

      <section class="metrics section-tight" aria-label="Resumen de la propuesta">
        <div class="container metrics-grid">
          <div><strong>USD 400</strong><span>Inversión total</span></div>
          <div><strong>10</strong><span>Días hábiles*</span></div>
          <div><strong>2</strong><span>Flujos comerciales</span></div>
          <div><strong>14 días</strong><span>Garantía técnica</span></div>
        </div>
      </section>

      <section class="section dark">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow"><span></span> OPORTUNIDAD</div>
            <h2>De una web informativa a una <em>plataforma comercial.</em></h2>
            <p>La web actual ya presenta la empresa y sus servicios. El salto de valor está en organizar esa experiencia para que cada visitante entienda la capacidad de CACERCA, compruebe su trayectoria y pueda iniciar una conversación comercial con facilidad.</p>
          </div>
          <div class="scope-grid">
            <article class="scope-card"><span>HOY</span><h3>Capacidades enumeradas</h3><p>La información técnica existe, pero exige más esfuerzo para descubrirla y convertirla en confianza.</p></article>
            <article class="scope-card"><span>PROPUESTA</span><h3>Experiencia demostrada</h3><p>Servicios y proyectos se presentan con jerarquía, contexto y argumentos relevantes para clientes industriales.</p></article>
            <article class="scope-card"><span>RESULTADO</span><h3>Contacto accionable</h3><p>Cotizaciones, llamadas, WhatsApp y proveedores se convierten en recorridos claros y medibles.</p></article>
          </div>
        </div>
      </section>

      <section class="section dark" id="alcance">
        <div class="container">
          <div class="section-heading"><div class="eyebrow"><span></span> ALCANCE DEL PROYECTO</div><h2>Una presencia digital diseñada para <em>mover oportunidades.</em></h2><p>La estructura sigue el recorrido indicado en el briefing: empresa, servicios, contacto o cotización y proveedores.</p></div>
          <div class="scope-grid">{scope.map(([n, title, text]) => <article class="scope-card"><span>{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
        </div>
      </section>

      <section class="section light">
        <div class="container split">
          <div class="sticky-copy"><div class="eyebrow dark-eye"><span></span> ENTREGABLES</div><h2>Todo lo necesario para una <em>primera fase sólida.</em></h2><p>Una renovación enfocada, profesional y coherente con la referencia corporativa indicada por el cliente, sin sobrecargar el presupuesto con funciones que corresponden a una fase posterior.</p></div>
          <div class="feature-list">{features.map((item, i) => <div><span>{String(i + 1).padStart(2, "0")}</span><p>{item}</p><b>✓</b></div>)}</div>
        </div>
      </section>

      <section class="section dark" id="inversion">
        <div class="container">
          <div class="section-heading center"><div class="eyebrow"><span></span> INVERSIÓN</div><h2>Una propuesta enfocada en <em>resultado comercial.</em></h2></div>
          <div class="price-card">
            <div class="price-top"><div><span>Renovación de presencia digital</span><h3>Plataforma comercial CACERCA Energía</h3></div><div class="price"><small>USD</small>$400</div></div>
            <div class="price-body">
              <ul><li>Rediseño responsive</li><li>Arquitectura comercial</li><li>Servicios y proyectos</li><li>Cotizaciones y proveedores</li><li>SEO y analítica básicos</li><li>Publicación y garantía</li></ul>
              <div class="price-note"><strong>Precio cerrado</strong><p>El valor cubre el alcance y una ronda consolidada de ajustes. Cualquier funcionalidad adicional se cotizará antes de ejecutarse.</p></div>
            </div>
          </div>
          <p class="caption">Dominio, hosting, licencias, producción audiovisual, traducciones y servicios de terceros no están incluidos y serán pagados directamente por el cliente.</p>
        </div>
      </section>

      <section class="section costs">
        <div class="container">
          <div class="section-heading"><div class="eyebrow dark-eye"><span></span> CRECIMIENTO OPCIONAL</div><h2>Preparada para avanzar <em>por etapas.</em></h2><p>El briefing menciona usuarios en EE. UU. y en inglés, aunque también marca los idiomas como “No aplica”. Por eso la versión bilingüe se mantiene como una decisión opcional.</p></div>
          <div class="transaction-grid">
            <article><span>Versión en inglés</span><strong>USD 95</strong><p>Implementación de la segunda versión cuando el cliente entrega las traducciones definitivas.</p></article>
            <article><span>Mantenimiento</span><strong>Desde USD 70/mes</strong><p>Actualizaciones, respaldos, soporte y cambios menores bajo un plan mensual independiente.</p></article>
            <article class="accent"><span>Fase posterior</span><strong>Portal avanzado</strong><p>CRM, automatizaciones o un portal privado de proveedores se estimarán cuando exista un flujo validado.</p></article>
          </div>
        </div>
      </section>

      <section class="section dark exclusions">
        <div class="container">
          <div class="section-heading"><div class="eyebrow"><span></span> FUERA DEL ALCANCE</div><h2>Una primera fase clara, <em>sin costos ocultos.</em></h2><p>Estas exclusiones mantienen el proyecto dentro del presupuesto definido.</p></div>
          <div class="scope-grid">
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Portal o cuentas privadas</h3><p>No incluye usuarios, autenticación, paneles, CRM ni un sistema privado para proveedores.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Producción de contenido</h3><p>No incluye fotografía, video, traducción, redacción extensa ni creación de identidad de marca.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Campañas y redes</h3><p>No incluye gestión de redes sociales, pauta publicitaria, email marketing ni estrategia de contenidos.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Integraciones avanzadas</h3><p>No incluye ERP, APIs a medida, automatizaciones, almacenamiento documental ni reportes personalizados.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Servicios de terceros</h3><p>Hosting, dominio, correo, licencias y plataformas externas se contratan por cuenta del cliente.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Soporte continuo</h3><p>La garantía cubre errores de nuestra implementación; mantenimiento y nuevos cambios se contratan aparte.</p></article>
          </div>
        </div>
      </section>

      <section class="section dark timeline-section" id="plan">
        <div class="container">
          <div class="section-heading"><div class="eyebrow"><span></span> PLAN DE TRABAJO</div><h2>Diez días de trabajo <em>en cuatro etapas.</em></h2></div>
          <div class="timeline">{phases.map(([time, title, text], i) => <article><div class="number">{i + 1}</div><span>{time}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
        </div>
      </section>

      <section class="section payment" id="pagos">
        <div class="container">
          <div class="section-heading"><div class="eyebrow dark-eye"><span></span> MÉTODO DE PAGO</div><h2>Dos hitos, <em>un avance ordenado.</em></h2></div>
          <div class="payment-grid">
            <article><strong>50%</strong><h3>Para reservar e iniciar</h3><p>USD 200</p></article>
            <article><strong>50%</strong><h3>Antes de publicar</h3><p>USD 200</p></article>
          </div>
          <div class="bank-card"><div><span>DATOS PARA TRANSFERENCIA</span><h3>Se comparten al aceptar la propuesta</h3><p>Los datos bancarios se enviarán por el canal comercial validado.</p></div><div class="bank-status"><span></span> Pendiente de confirmación</div></div>
        </div>
      </section>

      <section class="section dark requirements">
        <div class="container split">
          <div><div class="eyebrow"><span></span> REQUERIMIENTOS DEL CLIENTE</div><h2>Lo que necesitamos para <em>comenzar.</em></h2></div>
          <ol>{requirements.map(([n, title, text]) => <li><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
        </div>
        <div class="container requirement-alert"><strong>El plazo inicia con el material completo.</strong><p>Los 10 días hábiles comienzan al recibir el anticipo, los accesos y el contenido definitivo. Retrasos en entregas o aprobaciones desplazan la fecha de publicación.</p></div>
      </section>

      <section class="cta" id="aceptacion">
        <div class="container cta-inner">
          <div class="eyebrow"><span></span> SIGUIENTE PASO</div>
          <h2>Convirtamos la experiencia de CACERCA en <em>nuevas oportunidades.</em></h2>
          <p>Al aprobar coordinamos el anticipo, el checklist de materiales y la fecha de inicio.</p>
          <div class="hero-actions"><a class="button" href="https://wa.me/584262590251?text=Hola%2C%20quiero%20aprobar%20la%20propuesta%20de%20renovaci%C3%B3n%20digital%20de%20CACERCA%20Energ%C3%ADa%20por%20USD%20400." rel="noreferrer">Aprobar por WhatsApp</a><a class="button button-ghost" href="#inicio">Volver arriba ↑</a></div>
          <div class="validity">Propuesta válida por 15 días · USD 400 · Alcance sujeto a los requerimientos y límites aquí descritos.</div>
        </div>
      </section>
    </main>
    <footer><div class="container"><div class="brand"><img src="/Logo/Logo blanco.png" alt="Grupo Rincón" width="148" height="52" /></div><p>Desarrollamos la tecnología que tu negocio necesita para vender más y operar mejor.</p><span>Propuesta confidencial · 2026</span></div></footer>
  </body>
</html>
