---
import "../styles/propuesta-shopify.css";
const scope = [
  [
    "01",
    "Configuración inicial",
    "Ajustes generales de Shopify: idioma, moneda, datos del negocio y preferencias esenciales.",
  ],
  [
    "02",
    "Tema gratuito",
    "Instalación y puesta en marcha de un tema oficial gratuito, usando sus opciones nativas.",
  ],
  [
    "03",
    "Catálogo inicial",
    "Carga de hasta 10 productos con información, precios y fotografías entregados por el cliente.",
  ],
  [
    "04",
    "Pagos y envíos",
    "Vinculación de una pasarela ya aprobada y configuración básica de zonas o tarifas de envío.",
  ],
  [
    "05",
    "Páginas esenciales",
    "Contacto y políticas a partir de textos definitivos proporcionados o plantillas generales.",
  ],
  [
    "06",
    "Pruebas y entrega",
    "Prueba de navegación, carrito y checkout, publicación y capacitación remota de hasta 60 minutos.",
  ],
];

const features = [
  "Tema gratuito oficial de Shopify",
  "Logo, colores y tipografías dentro de las opciones del tema",
  "Menú principal y pie de página",
  "Hasta 10 productos iniciales",
  "Colecciones básicas",
  "Carrito y checkout estándar de Shopify",
  "Una pasarela de pago compatible y previamente aprobada",
  "Zonas o tarifas básicas de envío",
  "Página de contacto",
  "Políticas comerciales con textos suministrados",
  "Vinculación de dominio existente",
  "Prueba funcional antes de publicar",
  "Una ronda de ajustes menores",
  "Capacitación remota de hasta 60 minutos",
  "7 días de garantía sobre errores de configuración",
];

const phases = [
  ["Paso 1", "Recepción", "Pago, accesos y entrega completa del material requerido."],
  ["Días 1–2", "Configuración", "Tema, identidad básica, navegación, catálogo y páginas."],
  ["Días 3–4", "Comercio", "Pasarela aprobada, envíos y pruebas funcionales."],
  ["Día 5", "Entrega", "Ajustes menores, capacitación y publicación."],
];

const totalInvestment = 200;

const paymentPlan = [
  ["100", "Antes de comenzar", "USD 200"],
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
    />
    <meta
      name="googlebot"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />
    <meta name="bingbot" content="noindex, nofollow, noarchive" />
    <meta name="GPTBot" content="noindex, nofollow, noarchive" />
    <meta name="CCBot" content="noindex, nofollow, noarchive" />
    <meta name="ClaudeBot" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta
      name="description"
      content="Propuesta privada para la configuración esencial de una tienda Shopify."
    />
    <title>Propuesta privada · Configuración Shopify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav-shell">
      <nav class="nav container" aria-label="Navegación de la propuesta">
        <a
          class="brand"
          href="#inicio"
          aria-label="Grupo Rincón, volver al inicio"
        >
          <img
            src="/Logo/Logo blanco.webp"
            alt="Grupo Rincón"
            width="148"
            height="52"
          />
        </a>
        <div class="nav-links">
          <a href="#alcance">Alcance</a><a href="#inversion">Inversión</a><a
            href="#proyeccion">Proyección</a
          ><a href="#pagos">Pagos</a>
        </div>
        <a class="button button-small" href="#aceptacion">Aprobar propuesta</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="orb orb-one"></div><div class="orb orb-two"></div><div
          class="grid-lines"
        >
        </div>
        <div class="container hero-inner">
          <div class="eyebrow">
            <span></span> PROPUESTA CONFIDENCIAL · SHOPIFY
          </div>
          <h1>
            Tu tienda Shopify <em>lista para comenzar a vender.</em>
          </h1>
          <p class="hero-copy">
            Configuración esencial sobre un tema gratuito oficial. Una solución
            sencilla y funcional, sin diseño ni desarrollo personalizado.
          </p>
          <div class="hero-actions">
            <a class="button" href="#inversion">Ver inversión <span>↓</span></a>
            <a class="button button-ghost" href="#alcance">Explorar alcance</a>
          </div>
          <div class="hero-note">
            <span class="lock">●</span> Documento privado · válido por 15 días
          </div>
        </div>
      </section>

      <section
        class="metrics section-tight"
        aria-label="Resumen de la propuesta"
      >
        <div class="container metrics-grid">
          <div>
            <strong>USD ${totalInvestment}</strong><span
              >Inversión total</span
            >
          </div>
          <div><strong>3–5</strong><span>Días hábiles*</span></div>
          <div><strong>10</strong><span>Productos incluidos</span></div>
          <div><strong>7 días</strong><span>Garantía de configuración</span></div>
        </div>
      </section>

      <section class="section dark" id="alcance">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow"><span></span> ALCANCE DEL PROYECTO</div>
            <h2>Lo esencial para <em>poner Shopify en marcha.</em></h2>
            <p>
              Este servicio cubre configuración, carga inicial y publicación.
              No contempla una tienda diseñada a la medida.
            </p>
          </div>
          <div class="scope-grid">
            {
              scope.map(([n, title, text]) => (
                <article class="scope-card">
                  <>
                    <span>{n}</span>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section light">
        <div class="container split">
          <div class="sticky-copy">
            <div class="eyebrow dark-eye"><span></span> FUNCIONALIDADES</div>
            <h2>
              Una tienda funcional usando <em>las capacidades del tema.</em>
            </h2>
            <p>
              El resultado visual dependerá del tema gratuito seleccionado y de
              la calidad del logo, fotografías y textos entregados por el cliente.
            </p>
          </div>
          <div class="feature-list">
            {
              features.map((item, i) => (
                <div>
                  <>
                    <span>{String(i + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                    <b>✓</b>
                  </>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section dark" id="inversion">
        <div class="container">
          <div class="section-heading center">
            <div class="eyebrow"><span></span> INVERSIÓN</div>
            <h2>Una cifra clara. <em>Un alcance definido.</em></h2>
          </div>
          <div class="price-card">
            <div class="price-top">
              <div>
                <span>Configuración esencial</span><h3>
                  Puesta en marcha de tienda Shopify
                </h3>
              </div><div class="price"><small>USD</small>$200</div>
            </div>
            <div class="price-body">
              <ul>
                <li>Tema gratuito oficial</li><li>Configuración general</li>
                <li>Hasta 10 productos</li><li>Pagos y envíos básicos</li>
                <li>Capacitación y publicación</li><li>7 días de garantía</li>
              </ul>
              <div class="price-note">
                <strong>Condición esencial</strong><p>
                  El plazo comienza cuando recibamos el pago, todos los accesos
                  y el material completo y definitivo.
                </p>
              </div>
            </div>
          </div>
          <p class="caption">
            Shopify, dominio, aplicaciones y comisiones de pago no están
            incluidos en los USD 200 y serán pagados directamente por el cliente.
          </p>
        </div>
      </section>

      <section class="section dark exclusions" id="limites">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow"><span></span> FUERA DEL ALCANCE</div>
            <h2>Para mantener el precio, <em>estos límites son indispensables.</em></h2>
            <p>Cualquier necesidad adicional se revisará y cotizará antes de ejecutarse.</p>
          </div>
          <div class="scope-grid">
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Diseño personalizado</h3><p>No se replica el estilo de ILMIN, no se crean prototipos UI/UX ni se programa un tema a la medida.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Producción de contenido</h3><p>No incluye fotografía, retoque, branding, redacción comercial, traducción ni creación de políticas legales.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Funciones avanzadas</h3><p>No incluye filtros especiales, automatizaciones, integraciones a medida, ERP ni facturación electrónica.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Marketing y analítica</h3><p>No incluye SEO avanzado, pauta, email marketing, gestión de redes, GA4, píxeles ni Search Console.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Catálogo adicional</h3><p>La propuesta cubre hasta 10 productos. Productos, variantes o cargas adicionales se cotizan aparte.</p></article>
            <article class="scope-card"><span>NO INCLUIDO</span><h3>Soporte continuo</h3><p>No incluye mantenimiento mensual. La garantía de 7 días cubre únicamente errores de nuestra configuración.</p></article>
          </div>
        </div>
      </section>

      <section class="section costs" id="proyeccion">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow dark-eye">
              <span></span> COSTOS DE OPERACIÓN
            </div>
            <h2>Proyección mensual <em>transparente.</em></h2>
            <p>
              Estos valores son independientes de nuestros USD 200. El cliente
              contratará y pagará directamente Shopify, dominio, pasarela y
              cualquier licencia necesaria.
            </p>
          </div>
          <div class="cost-table" role="table" aria-label="Costos recurrentes">
            <div class="table-row table-head" role="row">
              <span>Concepto</span><span>Frecuencia</span><span>Estimado</span
              ><span>Tipo</span>
            </div>
            <div class="table-row">
              <b>Plan de Shopify</b><span>Mensual o anual</span><strong>Según plan vigente</strong><i
                >Requerido</i
              >
            </div>
            <div class="table-row">
              <b>Dominio</b><span>Anual</span><strong>USD 15–30</strong><i
                >Requerido</i
              >
            </div>
            <div class="table-row">
              <b>Tema oficial gratuito</b><span>Único</span><strong
                >USD 0</strong
              ><i>Incluido</i>
            </div>
            <div class="table-row">
              <b>Aplicaciones adicionales</b><span>Variable</span><strong>Según necesidad</strong><i
                class="optional">Opcional</i
              >
            </div>
            <div class="table-row total">
              <b>Responsable de estos pagos</b><span></span><strong>El cliente</strong
              ><i>Fuera de la propuesta</i>
            </div>
          </div>
          <div class="transaction-grid">
            <article>
              <span>Wompi</span><strong>2,65% + $700 COP + IVA</strong><p>
                Tarifa publicada por transacción en el Plan Avanzado.
              </p>
            </article>
            <article>
              <span>Shopify</span><strong>Tarifa según plan</strong><p>
                Puede aplicar un cargo por utilizar un proveedor de pagos externo.
              </p>
            </article>
            <article class="accent">
              <span>Importante</span><strong>Costos variables</strong
              ><p>Las tarifas deben confirmarse directamente con cada proveedor antes de contratar.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section dark timeline-section">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow"><span></span> PLAN DE TRABAJO</div><h2>
              Una puesta en marcha <em>rápida y ordenada.</em>
            </h2>
          </div>
          <div class="timeline">
            {
              phases.map(([time, title, text], i) => (
                <article>
                  <>
                    <div class="number">{i + 1}</div>
                    <span>{time}</span>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section payment" id="pagos">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow dark-eye">
              <span></span> MÉTODO DE PAGO DEL PROYECTO
            </div><h2>Un pago para <em>reservar e iniciar.</em></h2>
          </div>
          <div class="payment-grid">
            {
              paymentPlan.map(([percent, label, amount]) => (
                <article>
                  <>
                    <strong>{percent}</strong>
                    <h3>{label}</h3>
                    <p>{amount}</p>
                  </>
                </article>
              ))
            }
          </div>
          <div class="bank-card">
            <div>
              <span>DATOS PARA TRANSFERENCIA</span><h3>
                Se comparten al aceptar la propuesta
              </h3><p>
                Por seguridad, los datos bancarios definitivos se enviarán por
                el canal comercial validado y se incorporarán aquí únicamente
                con autorización expresa.
              </p>
            </div>
            <div class="bank-status">
              <span></span> Pendiente de confirmación
            </div>
          </div>
        </div>
      </section>

      <section class="section dark requirements">
        <div class="container split">
          <div>
            <div class="eyebrow">
              <span></span> REQUERIMIENTOS DEL CLIENTE
            </div><h2>Lo que necesitamos para <em>comenzar.</em></h2>
          </div>
          <ol>
            <li>
              <span>01</span><div>
                <h3>Marca y contenido</h3><p>
                  Logo en buena calidad, colores, datos de contacto, redes y textos definitivos.
                </p>
              </div>
            </li>
            <li>
              <span>02</span><div>
                <h3>Catálogo</h3><p>
                  Hasta 10 productos con nombre, descripción, precio, inventario,
                  variantes y fotografías listas para publicar.
                </p>
              </div>
            </li>
            <li>
              <span>03</span><div>
                <h3>Información comercial</h3><p>
                  Datos legales, políticas, zonas, tarifas y tiempos de envío,
                  condiciones de cambios y devoluciones.
                </p>
              </div>
            </li>
            <li>
              <span>04</span><div>
                <h3>Cuentas y validaciones</h3><p>
                  Accesos de Shopify y dominio, además de una cuenta de pasarela
                  aprobada y habilitada a nombre del cliente.
                </p>
              </div>
            </li>
            <li>
              <span>05</span><div>
                <h3>Pagos de terceros</h3><p>
                  Contratar directamente el plan de Shopify, dominio, aplicaciones
                  y asumir las comisiones de cada proveedor.
                </p>
              </div>
            </li>
            <li>
              <span>06</span><div>
                <h3>Revisión oportuna</h3><p>
                  Revisar la tienda y consolidar una única ronda de ajustes menores
                  dentro de las 48 horas posteriores a la entrega.
                </p>
              </div>
            </li>
          </ol>
        </div>
        <div class="container requirement-alert">
          <strong>El plazo de 3–5 días no inicia con la aprobación.</strong>
          <p>Inicia únicamente cuando se haya recibido el pago y todos los materiales, accesos y cuentas aprobadas. Retrasos o información incompleta del cliente desplazan la fecha de entrega.</p>
        </div>
      </section>

      <section class="cta" id="aceptacion">
        <div class="container cta-inner">
          <div class="eyebrow"><span></span> SIGUIENTE PASO</div>
          <h2>
            Pongamos tu tienda <em>en funcionamiento.</em>
          </h2>
          <p>
            Al aprobar coordinamos el pago, la recepción del material y el inicio.
            El trabajo comenzará cuando el checklist esté completo.
          </p>
          <div class="hero-actions">
            <a
              class="button"
              href="https://wa.me/573219646346?text=Hola%2C%20quiero%20aprobar%20la%20configuraci%C3%B3n%20esencial%20de%20Shopify%20por%20USD%20200."
              rel="noreferrer">Aprobar por WhatsApp</a
            ><a class="button button-ghost" href="#inicio">Volver arriba ↑</a>
          </div>
          <div class="validity">
            Propuesta válida por 15 días · USD 200 · Alcance sujeto estrictamente
            a los requerimientos y límites aquí descritos.
          </div>
        </div>
      </section>
    </main>
    <footer>
      <div class="container">
        <div class="brand">
          <img
            src="/Logo/Logo blanco.webp"
            alt="Grupo Rincón"
            width="148"
            height="52"
          />
        </div><p>
          Desarrollamos la tecnología que tu negocio necesita para vender más y
          operar mejor.
        </p><span>Propuesta confidencial · 2026</span>
      </div>
    </footer>
  </body>
</html>
