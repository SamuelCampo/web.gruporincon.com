---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Analytics from "@vercel/analytics/astro";
import SEO from "../components/SEO.astro";
import {
  M,
  MARKETS,
  MARKET_ID,
  DEFAULT_MARKET,
  CANONICAL_ONLY,
  type MarketId,
} from "../config/markets";

interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  /** Mercados donde existe esta misma URL. Por defecto, ambos (lleva hreflang). */
  markets?: MarketId[];
  /** Fuerza el canonical a un dominio (contenido idéntico en ambos sitios). */
  canonicalMarket?: MarketId;
}

const {
  title,
  description,
  breadcrumbs = [],
  socialImage = "/open-image.webp",
  socialImageAlt = "Grupo Rincon — Desarrollo web y software",
  socialImageWidth,
  socialImageHeight,
  markets = ["ve", "co"],
} = Astro.props;
const pathname = Astro.url.pathname;
const forcedCanonical: MarketId | undefined =
  Astro.props.canonicalMarket ??
  CANONICAL_ONLY.find((c) => pathname.startsWith(c.prefix))?.market;
const canonicalMarket: MarketId = forcedCanonical ?? MARKET_ID;
const canonicalURL = new URL(pathname, MARKETS[canonicalMarket].url);
// hreflang sólo cuando la página existe en ambos dominios y cada uno es su propio
// canonical. Si el canonical está forzado a un dominio (blog), no hay alternativas.
const alternates =
  !forcedCanonical && markets.length > 1
    ? markets.map((id) => ({
        hreflang: MARKETS[id].hreflang,
        href: new URL(pathname, MARKETS[id].url).toString(),
      }))
    : [];
const xDefault = markets.includes(DEFAULT_MARKET)
  ? new URL(pathname, MARKETS[DEFAULT_MARKET].url).toString()
  : null;
const socialImageURL = new URL(socialImage, canonicalURL).toString();
const socialImageType = socialImage.endsWith(".avif")
  ? "image/avif"
  : socialImage.endsWith(".webp")
    ? "image/webp"
    : undefined;
---

<!doctype html>
<html lang={M.hreflang}>
  <head>
    <!-- Google Tag Manager: se carga tras idle o primera interacción para no competir con LCP/FCP -->
    <script is:inline>
      (function (w, d, i) {
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });

        var loaded = false;
        function loadGTM() {
          if (loaded) return;
          loaded = true;
          var s = d.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
          d.head.appendChild(s);
        }

        ["pointerdown", "keydown", "scroll", "touchstart"].forEach(
          function (evt) {
            w.addEventListener(evt, loadGTM, { once: true, passive: true });
          },
        );

        function schedule() {
          if ("requestIdleCallback" in w) {
            w.requestIdleCallback(loadGTM, { timeout: 4000 });
          } else {
            setTimeout(loadGTM, 3500);
          }
        }

        if (d.readyState === "complete") schedule();
        else w.addEventListener("load", schedule);
      })(window, document, "GTM-TKMC3FKH");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description || M.defaultDescription}
    />
    <meta
      name="keywords"
      content={M.keywords}
    />
    <meta name="author" content="Grupo Rincon" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description ||
        "Desarrollamos el software y las páginas web que tu negocio necesita para crecer en el mundo digital."}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Grupo Rincon" />
    <meta property="og:locale" content={M.ogLocale} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      socialImageType && (
        <meta property="og:image:type" content={socialImageType} />
      )
    }
    {
      socialImageWidth && (
        <meta property="og:image:width" content={String(socialImageWidth)} />
      )
    }
    {
      socialImageHeight && (
        <meta property="og:image:height" content={String(socialImageHeight)} />
      )
    }
    <meta
      property="og:logo"
      content={new URL("/Logo/Logo blanco.webp", canonicalURL).toString()}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content={description ||
        "Desarrollamos el software y las páginas web que tu negocio necesita para crecer en el mundo digital."}
    />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      alternates.length > 0 && xDefault && (
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      )
    }
    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz,wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Montserrat-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <!-- <link rel="icon" href="/favicon.svg" type="image/svg+xml" /> -->
    <link rel="icon" type="image/avif" href="/Logo/Favicon.avif" />
    <title>{title}</title>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) =>
              e.target.classList.toggle("visible", e.isIntersecting),
            );
          },
          { threshold: 0.15 },
        );
        function observeReveals() {
          document
            .querySelectorAll(".reveal")
            .forEach((el) => observer.observe(el));
        }
        observeReveals();
        document.addEventListener("astro:page-load", observeReveals);
      });
    </script>
    <script
      src="https://analytics.ahrefs.com/analytics.js"
      is:inline={true}
      data-key="ECGcFI1RYcHXFMXmW2SGKA"
      async></script>
    <Analytics />
    <SEO breadcrumbs={breadcrumbs} />
    <!-- TrustBox script -->
    <script
      type="text/javascript"
      src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"
      async></script>
    <!-- End TrustBox script -->
  </head>
  <body class="bg-black text-zinc-300 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TKMC3FKH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <main>
      <slot />
    </main>
    <WhatsAppButton />
    <Footer />
  </body>
</html>
